<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings. Run it through scripts/coverage.ps1, which passes this file,
  runs both test projects and merges their two reports into one figure.

  WHY THE EXCLUSIONS MATTER: EF's generated migrations and model snapshot are
  ~156,000 of ~171,000 "lines", none executed by tests and none worth testing.
  Measured raw the suite reports 0.6%; measured against hand-written code it is
  an order of magnitude higher. The number is meaningless without this list.

  HISTORY, so nobody re-lives it: this file previously produced ZERO coverage
  files, and the note left in it blamed the collector friendlyName casing. That
  was wrong on both counts. The real fault was that the note itself contained a
  double hyphen (from spelling out the command-line switches), and XML forbids
  that inside a comment. VSTest rejected the whole file with "Settings file
  provided does not conform to required format", printed it as one line in the
  middle of ordinary test output, and carried on without a collector. Keep
  command-line switches OUT of the comments here; put them in the script.

  friendlyName matching is case-insensitive, verified by running it both ways.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Generated or third-party: excluded by source path. -->
          <ExcludeByFile>
            **/Migrations/*.cs,
            **/Migrations/**/*.cs,
            **/obj/**/*.cs,
            **/*.Designer.cs,
            **/*.g.cs,
            **/*.razor.g.cs
          </ExcludeByFile>

          <!-- Test projects must not count toward their own coverage. -->
          <Exclude>[SchoolErp.UnitTests]*,[SchoolErp.IntegrationTests]*</Exclude>

          <!-- Compiler-generated members and anything explicitly opted out. -->
          <ExcludeByAttribute>
            Obsolete,
            GeneratedCodeAttribute,
            CompilerGeneratedAttribute,
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>

          <!-- Record hit COUNTS rather than a hit/not-hit flag: it costs a little
               speed and tells you whether a line ran once or ten thousand times.
               (This has nothing to do with merging the two test runs — that is
               ReportGenerator's job in scripts/coverage.ps1.) -->
          <SingleHit>false</SingleHit>
          <!-- SourceLink rewrites every filename in the report into a
               raw.githubusercontent URL pinned to the last COMMITTED sha. On a
               private repo every one of those 404s, so the merge spends a few
               hundred failed requests and the HTML report shows no source at
               all — and uncommitted work points at a commit that predates it.
               Local paths are more useful and work offline. -->
          <UseSourceLink>false</UseSourceLink>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
