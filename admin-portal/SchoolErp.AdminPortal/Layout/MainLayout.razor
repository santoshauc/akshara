@inherits LayoutComponentBase
@implements IDisposable
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation
@inject TenantsClient TenantsApi
@inject HttpClient Http
@inject IJSRuntime Js
@inject AuthenticationStateProvider AuthState

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

@* App chrome lives directly under MudLayout — nesting it inside AuthorizeView
   breaks MudBlazor's appbar/drawer/content coordination (drawer offsets,
   toggle glitches). The login page uses EmptyLayout, and [Authorize] pages
   redirect before content renders, so the chrome is safe to render always. *@
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" />
        @if (_branding?.LogoUrl is { } logoUrl)
        {
            <MudImage Src="@($"{ApiBase}{logoUrl}")" Alt="School logo"
                      Style="max-height: 36px; max-width: 90px; object-fit: contain;"
                      Class="ml-2 rounded" />
        }
        <MudText Typo="Typo.h6" Class="ml-2">@(_branding?.Name ?? "Akshara Admin")</MudText>
        @if (_branding is not null)
        {
            <MudText Typo="Typo.caption" Class="ml-2" Style="opacity: 0.75;">on Akshara</MudText>
        }
        <MudSpacer />
        <MudTooltip Text="Toggle dark mode">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="@(() => _isDarkMode = !_isDarkMode)" />
        </MudTooltip>
        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight">
            <AuthorizeView>
                <Authorized>
                    <MudMenuItem Disabled="true">@context.User.Identity?.Name</MudMenuItem>
                </Authorized>
            </AuthorizeView>
            <MudMenuItem OnClick="@(() => Navigation.NavigateTo("devices"))">My devices</MudMenuItem>
            <MudMenuItem OnClick="@(() => Navigation.NavigateTo("security"))">Security</MudMenuItem>
            <MudDivider />
            <MudMenuItem OnClick="LogoutAsync">Sign out</MudMenuItem>
        </MudMenu>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" ClipMode="DrawerClipMode.Always">
        <MudNavMenu>
            <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                Dashboard
            </MudNavLink>
            @if (_isPlatformUser)
            {
                <MudNavLink Href="tenants" Icon="@Icons.Material.Filled.School">
                    Schools
                </MudNavLink>
            }
            <MudDivider Class="my-2" />
            <MudNavLink Href="academics" Icon="@Icons.Material.Filled.CalendarMonth">
                Academics
            </MudNavLink>
            <MudNavLink Href="students" Icon="@Icons.Material.Filled.Groups">
                Students
            </MudNavLink>
            <MudNavLink Href="admissions" Icon="@Icons.Material.Filled.PersonAddAlt1">
                Admissions
            </MudNavLink>
            <MudNavLink Href="attendance" Icon="@Icons.Material.Filled.EventAvailable">
                Attendance
            </MudNavLink>
            <MudNavLink Href="exams" Icon="@Icons.Material.Filled.Quiz">
                Exams
            </MudNavLink>
            <MudNavLink Href="fees" Icon="@Icons.Material.Filled.Payments">
                Fees
            </MudNavLink>
            <MudNavLink Href="homework" Icon="@Icons.Material.Filled.MenuBook">
                Homework
            </MudNavLink>
            <MudNavLink Href="notices" Icon="@Icons.Material.Filled.Campaign">
                Notices
            </MudNavLink>
            <MudNavLink Href="transport" Icon="@Icons.Material.Filled.DirectionsBus">
                Transport
            </MudNavLink>
            <MudNavLink Href="timetable" Icon="@Icons.Material.Filled.CalendarViewWeek">
                Timetable
            </MudNavLink>
            <MudNavLink Href="teachers" Icon="@Icons.Material.Filled.Badge">
                Teachers
            </MudNavLink>
            <MudNavLink Href="library" Icon="@Icons.Material.Filled.LocalLibrary">
                Library
            </MudNavLink>
            <MudNavLink Href="hostel" Icon="@Icons.Material.Filled.Bed">
                Hostel
            </MudNavLink>
            <MudNavLink Href="leave" Icon="@Icons.Material.Filled.EventBusy">
                Leave
            </MudNavLink>
            <MudNavLink Href="messages" Icon="@Icons.Material.Filled.Forum">
                Messages
            </MudNavLink>
            <MudNavLink Href="users" Icon="@Icons.Material.Filled.ManageAccounts">
                Users &amp; roles
            </MudNavLink>
            <MudNavLink Href="insights" Icon="@Icons.Material.Filled.Insights">
                Insights
            </MudNavLink>
            @if (!_isPlatformUser)
            {
                <MudNavLink Href="subscription" Icon="@Icons.Material.Filled.CardMembership">
                    Subscription
                </MudNavLink>
            }
            <MudNavLink Href="audit" Icon="@Icons.Material.Filled.History">
                Audit log
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>
    @* No padding class directly on MudMainContent — it would override the
       component's own padding-top (the fixed appbar offset). Pad inside. *@
    <MudMainContent>
        <div class="pa-6">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <MudAlert Severity="Severity.Error" Class="ma-4">
                    Something went wrong on this page.
                    <MudButton Variant="Variant.Text" Color="Color.Error"
                               OnClick="@(() => _errorBoundary?.Recover())">
                        Try again
                    </MudButton>
                </MudAlert>
            </ErrorContent>
        </ErrorBoundary>
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode;
    private ErrorBoundary? _errorBoundary;

    private MudTheme _theme = BuildTheme("#1565C0", null);
    private TenantBrandingDto? _branding;
    private bool _isPlatformUser;
    private bool _brandingAttempted;

    private string ApiBase => (Http.BaseAddress?.ToString() ?? "").TrimEnd('/');

    private static MudTheme BuildTheme(string primary, string? secondary) => new()
    {
        Palette = new PaletteLight
        {
            Primary = primary,
            AppbarBackground = primary,
            Secondary = secondary ?? "#FF4081",
        },
    };

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
        await RefreshPrincipalAsync();
        await LoadBrandingAsync();
    }

    /// <summary>Platform users see the school catalog; school users their subscription.</summary>
    private async Task RefreshPrincipalAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isPlatformUser = state.User.Identity?.IsAuthenticated == true &&
                          state.User.FindFirst("tenant") is null;
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task) =>
        _ = InvokeAsync(async () =>
        {
            await RefreshPrincipalAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Applies the signed-in school's logo and colours. The school code is
    /// remembered at login; branding is public data, so this also works
    /// straight after a hard refresh.
    /// </summary>
    private async Task LoadBrandingAsync()
    {
        if (_brandingAttempted)
        {
            return;
        }

        try
        {
            var code = await Js.InvokeAsync<string?>(
                "localStorage.getItem", "akshara.schoolCode");
            if (string.IsNullOrWhiteSpace(code))
            {
                return;
            }

            _brandingAttempted = true;
            _branding = await TenantsApi.GetBrandingAsync(code);
            if (_branding?.ThemePrimaryColor is { } primary)
            {
                _theme = BuildTheme(primary, _branding.ThemeSecondaryColor);
            }

            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            // The chrome falls back to default branding; pages surface errors.
        }
    }

    /// <summary>A crash on one page must not follow the user to the next.</summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        // First navigation after a fresh login: the code has just been stored.
        _ = LoadBrandingAsync();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    private async Task LogoutAsync()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
