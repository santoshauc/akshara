@inherits LayoutComponentBase
@implements IDisposable
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation
@inject TenantsClient TenantsApi
@inject HttpClient Http
@inject IJSRuntime Js
@inject AuthenticationStateProvider AuthState
@inject LocalizationService L

<MudThemeProvider @bind-IsDarkMode="_isDarkMode" Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

@* App chrome lives directly under MudLayout — nesting it inside AuthorizeView
   breaks MudBlazor's appbar/drawer/content coordination (drawer offsets,
   toggle glitches). The login page uses EmptyLayout, and [Authorize] pages
   redirect before content renders, so the chrome is safe to render always. *@
<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<MudLayout>
    <a class="ak-skip-link" href="#ak-main">@L["chrome.skipToContent"]</a>

    <MudAppBar Elevation="0" Class="ak-appbar" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" Size="Size.Small"
                       aria-label="@L["chrome.toggleNav"]"
                       aria-expanded="@(DrawerOpen ? "true" : "false")"
                       OnClick="ToggleDrawer" />

        @if (_branding?.LogoUrl is { } logoUrl)
        {
            <MudImage Src="@($"{ApiBase}{logoUrl}")" Alt=""
                      Style="max-height: 26px; max-width: 80px; object-fit: contain;"
                      Class="ml-1" />
        }
        else
        {
            <span class="ak-brand-mark ml-1" aria-hidden="true">@InitialsOf(_branding?.Name)</span>
        }

        <span class="ak-school-name ml-2">@(_branding?.Name ?? "Akshara")</span>
        @if (_isPlatformUser)
        {
            <span class="ak-env-chip ml-2">@L["chrome.platform"]</span>
        }

        <MudSpacer />

        <MudTooltip Text="@L["chrome.language"]">
            <MudButton Size="Size.Small" Variant="Variant.Text" Class="mr-1"
                       OnClick="@(() => SetLanguageAsync(L.Language == "en" ? "te" : "en"))">
                @(L.Language == "en" ? "తెలుగు" : "EN")
            </MudButton>
        </MudTooltip>

        <MudTooltip Text="@L["chrome.darkMode"]">
            <MudIconButton Size="Size.Small"
                           Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                           aria-label="@L["chrome.darkMode"]"
                           OnClick="ToggleDarkModeAsync" />
        </MudTooltip>

        <MudMenu Icon="@Icons.Material.Outlined.AccountCircle" Size="Size.Small"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                 aria-label="@L["chrome.account"]">
            <AuthorizeView>
                <Authorized>
                    <div style="padding: var(--ak-space-2) var(--ak-space-4); min-width: 200px;">
                        <div style="font-weight: var(--ak-weight-semibold); font-size: var(--ak-text-sm);">
                            @context.User.Identity?.Name
                        </div>
                        <div style="font-size: var(--ak-text-xs); color: var(--ak-text-secondary);">
                            @(_isPlatformUser ? L["chrome.platform"] : _branding?.Name)
                        </div>
                    </div>
                    <MudDivider />
                </Authorized>
            </AuthorizeView>
            <MudMenuItem Icon="@Icons.Material.Outlined.Devices"
                         OnClick="@(() => Navigation.NavigateTo("devices"))">@L["chrome.myDevices"]</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Shield"
                         OnClick="@(() => Navigation.NavigateTo("security"))">@L["chrome.security"]</MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="LogoutAsync">@L["chrome.signOut"]</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    @* Mini rail on desktop keeps navigation one click away; on a phone it
       would eat a sixth of the screen, so there it becomes an overlay. *@
    <MudDrawer Open="@DrawerOpen" OpenChanged="OnDrawerOpenChanged"
               Elevation="0" ClipMode="DrawerClipMode.Always"
               Variant="@(_isCompact ? DrawerVariant.Temporary : DrawerVariant.Mini)"
               OpenMiniOnHover="false"
               Class="@($"ak-drawer {(!_isCompact && !_desktopDrawerOpen ? "ak-drawer--rail" : "")}")">
        <nav class="ak-nav" aria-label="@L["chrome.mainNav"]">
            <MudNavMenu>
                @foreach (var section in VisibleSections)
                {
                    @if (_isCompact || _desktopDrawerOpen)
                    {
                        <div class="ak-nav-section">@L[section.LabelKey]</div>
                    }
                    else
                    {
                        <div class="ak-nav-section" aria-hidden="true"></div>
                    }

                    @foreach (var item in section.Items)
                    {
                        <MudNavLink Href="@item.Href" Icon="@item.Icon"
                                    Match="@(item.Href.Length == 0 ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                    title="@L[item.LabelKey]">
                            @L[item.LabelKey]
                        </MudNavLink>
                    }
                }
            </MudNavMenu>
        </nav>
    </MudDrawer>

    @* No padding class directly on MudMainContent — it would override the
       component's own padding-top (the fixed appbar offset). Pad inside. *@
    <MudMainContent>
        <main id="ak-main" class="ak-page" tabindex="-1">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <AkCard>
                        <AkErrorState Title="@L["error.pageTitle"]"
                                      Description="@L["error.pageBody"]"
                                      RetryLabel="@L["error.retry"]"
                                      OnRetry="@(() => _errorBoundary?.Recover())" />
                    </AkCard>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </MudMainContent>
</MudLayout>


@code {
    // Desktop and phone keep separate intent. A single flag defaulted to
    // true meant a phone opened with the nav covering the whole page, and
    // closing it on a breakpoint event was too late — the first paint had
    // already happened with the drawer over the content.
    private bool _desktopDrawerOpen = true;
    private bool _mobileDrawerOpen;

    private bool DrawerOpen => _isCompact ? _mobileDrawerOpen : _desktopDrawerOpen;

    private IReadOnlyList<NavSection> VisibleSections => NavModel.For(_isPlatformUser);

    /// <summary>Two-letter fallback mark when a school has no logo uploaded.</summary>
    private static string InitialsOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "AK";
        }

        var words = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return words.Length == 1
            ? words[0][..Math.Min(2, words[0].Length)].ToUpperInvariant()
            : $"{char.ToUpperInvariant(words[0][0])}{char.ToUpperInvariant(words[1][0])}";
    }

    private void ToggleDrawer()
    {
        if (_isCompact)
        {
            _mobileDrawerOpen = !_mobileDrawerOpen;
        }
        else
        {
            _desktopDrawerOpen = !_desktopDrawerOpen;
        }
    }

    /// <summary>Keeps our state in step when MudBlazor closes the overlay itself
    /// (backdrop tap, Escape, or navigating to a new page).</summary>
    private void OnDrawerOpenChanged(bool open)
    {
        if (_isCompact)
        {
            _mobileDrawerOpen = open;
        }
        else
        {
            _desktopDrawerOpen = open;
        }
    }

    private bool _isCompact;

    /// <summary>
    /// Tracks whether we are on a phone/small tablet. The drawer switches
    /// from a persistent rail to an overlay, and starts closed so content
    /// gets the full width.
    /// </summary>
    private void OnBreakpointChanged(Breakpoint breakpoint)
    {
        var compact = breakpoint is Breakpoint.Xs or Breakpoint.Sm;
        if (compact == _isCompact)
        {
            return;
        }

        _isCompact = compact;
        if (compact)
        {
            // Leaving a phone: the overlay should never persist across a resize.
            _mobileDrawerOpen = false;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Dark mode has to move in lockstep across both styling layers:
    /// MudBlazor's own palette and the CSS token set used by every shared
    /// primitive. Missing either leaves half the page in the wrong theme.
    /// </summary>
    private async Task ToggleDarkModeAsync()
    {
        _isDarkMode = !_isDarkMode;
        await Js.InvokeVoidAsync("akshara.setDark", _isDarkMode);
    }

    private bool _isDarkMode;
    private ErrorBoundary? _errorBoundary;

    private MudTheme _theme = AksharaTheme.Build(null, null);
    private TenantBrandingDto? _branding;
    private bool _isPlatformUser;
    private bool _brandingAttempted;

    private string ApiBase => (Http.BaseAddress?.ToString() ?? "").TrimEnd('/');

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        AuthState.AuthenticationStateChanged += OnAuthStateChanged;
        L.Changed += OnLanguageChanged;
        await L.InitializeAsync();
        await RefreshPrincipalAsync();
        await LoadBrandingAsync();
    }

    /// <summary>Platform users see the school catalog; school users their subscription.</summary>
    private async Task RefreshPrincipalAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        _isPlatformUser = state.User.Identity?.IsAuthenticated == true &&
                          state.User.FindFirst("tenant") is null;
    }

    private void OnAuthStateChanged(Task<AuthenticationState> task) =>
        _ = InvokeAsync(async () =>
        {
            await RefreshPrincipalAsync();
            StateHasChanged();
        });

    /// <summary>
    /// Applies the signed-in school's logo and colours. The school code is
    /// remembered at login; branding is public data, so this also works
    /// straight after a hard refresh.
    /// </summary>
    private async Task LoadBrandingAsync()
    {
        if (_brandingAttempted)
        {
            return;
        }

        try
        {
            var code = await Js.InvokeAsync<string?>(
                "localStorage.getItem", "akshara.schoolCode");
            if (string.IsNullOrWhiteSpace(code))
            {
                return;
            }

            _brandingAttempted = true;
            _branding = await TenantsApi.GetBrandingAsync(code);
            if (_branding?.ThemePrimaryColor is { } primary)
            {
                _theme = AksharaTheme.Build(primary, _branding.ThemeSecondaryColor);
                // The CSS layer needs the brand too — the nav's active state,
                // the logo fallback mark and focus accents all read --ak-brand.
                await Js.InvokeVoidAsync(
                    "akshara.setBrand", primary, "#ffffff",
                    AksharaTheme.LightenForDark(primary));
            }

            StateHasChanged();
        }
        catch (HttpRequestException)
        {
            // The chrome falls back to default branding; pages surface errors.
        }
    }

    /// <summary>A crash on one page must not follow the user to the next.</summary>
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _errorBoundary?.Recover();
        // First navigation after a fresh login: the code has just been stored.
        _ = LoadBrandingAsync();
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SetLanguageAsync(string language) => L.SetLanguageAsync(language);

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        AuthState.AuthenticationStateChanged -= OnAuthStateChanged;
        L.Changed -= OnLanguageChanged;
    }

    private async Task LogoutAsync()
    {
        await AuthApi.LogoutAsync();
        Navigation.NavigateTo("login");
    }
}
