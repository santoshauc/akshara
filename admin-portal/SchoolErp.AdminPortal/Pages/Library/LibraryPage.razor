@page "/library"
@attribute [Authorize]
@inject LibraryClient Client
@inject StudentsClient StudentsApi
@inject ISnackbar Snackbar

<PageTitle>Library — SchoolErp</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Library</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Catalog</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="_search" Label="Search" Clearable="true" Dense="true"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                              OnAdornmentClick="LoadBooksAsync"
                              OnKeyUp="@(e => e.Key == "Enter" ? LoadBooksAsync() : Task.CompletedTask)" />
            </MudStack>

            <MudTable Items="_books" Dense="true" Hover="true" Loading="_loading">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="@(new Func<BookDto, object>(b => b.Title))">Title</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="@(new Func<BookDto, object>(b => b.Author))">Author</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="@(new Func<BookDto, object>(b => b.CopiesAvailable))">Available</MudTableSortLabel></MudTh>
                    <MudTh />
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.Title</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(context.Category ?? "—")@(context.Isbn is null ? "" : $" · {context.Isbn}")
                        </MudText>
                    </MudTd>
                    <MudTd>@context.Author</MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small"
                                 Color="@(context.CopiesAvailable > 0 ? Color.Success : Color.Error)">
                            @context.CopiesAvailable / @context.CopiesTotal
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                   Disabled="@(context.CopiesAvailable == 0)"
                                   OnClick="@(() => OpenIssue(context))">
                            Issue
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="mud-text-secondary pa-4">No books yet — add the first one.</MudText>
                </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
            </PagerContent>
            </MudTable>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle2" Class="mb-2">Add a title</MudText>
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_newTitle" Label="Title" Style="min-width: 180px;" Dense="true" />
                <MudTextField @bind-Value="_newAuthor" Label="Author" Style="min-width: 140px;" Dense="true" />
                <MudTextField @bind-Value="_newCategory" Label="Category" Style="width: 120px;" Dense="true" />
                <MudNumericField @bind-Value="_newCopies" Label="Copies" Min="1" Max="1000"
                                 Style="width: 90px;" Dense="true" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                           OnClick="AddBookAsync">
                    Add
                </MudButton>
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Open loans</MudText>
                <MudSwitch @bind-Value="_overdueOnly" Color="Color.Error" Label="Overdue only"
                           T="bool" @bind-Value:after="LoadLoansAsync" />
            </MudStack>

            <MudTable Items="_loans" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="@(new Func<BookLoanDto, object>(l => l.BookTitle))">Book</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="@(new Func<BookLoanDto, object>(l => l.StudentName))">Student</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="@(new Func<BookLoanDto, object>(l => l.DueOn))">Due</MudTableSortLabel></MudTh>
                    <MudTh />
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.BookTitle</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.StudentName</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.AdmissionNumber</MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip Size="Size.Small" Color="@(context.Overdue ? Color.Error : Color.Default)">
                            @context.DueOn.ToString("dd MMM")
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success"
                                   OnClick="@(() => ReturnAsync(context))">
                            Return
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Class="mud-text-secondary pa-4">No open loans.</MudText>
                </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
            </PagerContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@if (_issueBook is not null)
{
    <MudPaper Elevation="2" Class="pa-6 mt-4" Style="max-width: 560px;">
        <MudText Typo="Typo.h6" Class="mb-2">Issue "@_issueBook.Title"</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_studentSearch" Label="Student name / admission no"
                          Style="min-width: 220px;" Dense="true"
                          OnKeyUp="@(e => e.Key == "Enter" ? SearchStudentsAsync() : Task.CompletedTask)" />
            <MudButton Variant="Variant.Outlined" OnClick="SearchStudentsAsync">Find</MudButton>
            <MudNumericField @bind-Value="_loanDays" Label="Days" Min="1" Max="90"
                             Style="width: 90px;" Dense="true" />
        </MudStack>
        @foreach (var student in _studentMatches)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                <MudText Typo="Typo.body2">
                    @student.FirstName @student.LastName · @student.AdmissionNumber
                    (@(student.ClassName ?? "—") @(student.SectionName ?? ""))
                </MudText>
                <MudSpacer />
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                           Disabled="_busy" OnClick="@(() => IssueAsync(student.Id))">
                    Issue to this student
                </MudButton>
            </MudStack>
        }
        <MudStack Row="true" Class="mt-3">
            <MudSpacer />
            <MudButton OnClick="@(() => _issueBook = null)">Close</MudButton>
        </MudStack>
    </MudPaper>
}

@code {
    private List<BookDto> _books = [];
    private List<BookLoanDto> _loans = [];
    private List<StudentListItemDto> _studentMatches = [];
    private BookDto? _issueBook;
    private string? _search;
    private string? _studentSearch;
    private string _newTitle = "";
    private string _newAuthor = "";
    private string? _newCategory;
    private int _newCopies = 1;
    private int _loanDays = 14;
    private bool _overdueOnly;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        await LoadBooksAsync();
        await LoadLoansAsync();
    }

    private async Task LoadBooksAsync()
    {
        _loading = true;
        try
        {
            _books = await Client.GetBooksAsync(_search);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadLoansAsync() => _loans = await Client.GetLoansAsync(_overdueOnly);

    private async Task AddBookAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newAuthor))
        {
            Snackbar.Add("Title and author are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.AddBookAsync(new AddBookRequest(
                _newTitle.Trim(), _newAuthor.Trim(), null, _newCategory, _newCopies));
            if (error is null)
            {
                Snackbar.Add("Book added.", Severity.Success);
                _newTitle = "";
                _newAuthor = "";
                _newCategory = null;
                _newCopies = 1;
                await LoadBooksAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenIssue(BookDto book)
    {
        _issueBook = book;
        _studentMatches = [];
        _studentSearch = null;
    }

    private async Task SearchStudentsAsync()
    {
        if (string.IsNullOrWhiteSpace(_studentSearch))
        {
            return;
        }

        var result = await StudentsApi.GetStudentsAsync(_studentSearch.Trim(), null, null, null, 1, 5);
        _studentMatches = result.Items.ToList();
    }

    private async Task IssueAsync(Guid studentId)
    {
        if (_issueBook is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.IssueAsync(
                new IssueBookRequest(_issueBook.Id, studentId, _loanDays));
            if (error is null)
            {
                Snackbar.Add("Book issued.", Severity.Success);
                _issueBook = null;
                await LoadBooksAsync();
                await LoadLoansAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReturnAsync(BookLoanDto loan)
    {
        var error = await Client.ReturnAsync(loan.Id);
        if (error is null)
        {
            Snackbar.Add($"Returned \"{loan.BookTitle}\".", Severity.Success);
            await LoadBooksAsync();
            await LoadLoansAsync();
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }
}
