@page "/"
@attribute [Authorize]
@implements IDisposable
@inject DashboardClient Client
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject LocalizationService L

<PageTitle>Dashboard — Akshara</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">@L["home.title"]</MudText>
    <MudSpacer />
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FactCheck"
               OnClick="@(() => Navigation.NavigateTo("attendance"))">@L["home.qaMarkAttendance"]</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => Navigation.NavigateTo("students/admit"))">@L["home.qaAdmitStudent"]</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Payments"
               OnClick="@(() => Navigation.NavigateTo("fees"))">@L["home.qaCollectFee"]</MudButton>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.UploadFile"
               OnClick="@(() => Navigation.NavigateTo("students"))">@L["home.qaImport"]</MudButton>
</MudStack>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_data is { } data)
{
    @if (data.SubscriptionExpiresOn is { } expiry && expiry <= DateOnly.FromDateTime(DateTime.Today.AddDays(30)))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
            @string.Format(L["home.subscriptionExpires"], expiry.ToString("dd MMM yyyy"))
        </MudAlert>
    }

    <MudGrid>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4" Style="cursor:pointer;"
                      @onclick="@(() => Navigation.NavigateTo("attendance"))">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["home.attendanceToday"]</MudText>
                <MudText Typo="Typo.h5">
                    @(data.AttendanceMarkedToday == 0 ? L["home.notMarked"] : $"{data.AttendanceTodayPercent:0.#}%")
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(data.AttendanceMarkedToday == 0
                        ? $"{data.ActiveStudents} {L["home.activeStudentsSuffix"]}"
                        : $"{data.PresentToday} {string.Format(L["home.markedPresent"], data.AttendanceMarkedToday)}")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4" Style="cursor:pointer;"
                      @onclick="@(() => Navigation.NavigateTo("fees"))">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["home.feesThisMonth"]</MudText>
                <MudText Typo="Typo.h5">₹@data.FeesCollectedThisMonth.ToString("N0")</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["home.feesOutstanding"]</MudText>
                <MudText Typo="Typo.h5"
                         Style="@(data.FeesOutstanding > 0 ? "color: var(--mud-palette-warning);" : "")">
                    ₹@data.FeesOutstanding.ToString("N0")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["home.activeStudents"]</MudText>
                <MudText Typo="Typo.h5">@data.ActiveStudents</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4" Style="cursor:pointer;"
                      @onclick="@(() => Navigation.NavigateTo("library"))">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["home.overdueBooks"]</MudText>
                <MudText Typo="Typo.h5"
                         Style="@(data.OverdueLoans > 0 ? "color: var(--mud-palette-error);" : "")">
                    @data.OverdueLoans
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["home.smsCredits"]</MudText>
                <MudText Typo="Typo.h5"
                         Style="@(data.SmsCredits < 500 ? "color: var(--mud-palette-error);" : "")">
                    @data.SmsCredits.ToString("N0")
                </MudText>
                @if (data.SmsCredits < 500)
                {
                    <MudText Typo="Typo.caption" Color="Color.Error">@L["home.smsLow"]</MudText>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-2">@L["home.attendanceTrend"]</MudText>
                @if (data.AttendanceTrend.Count == 0)
                {
                    <MudText Class="mud-text-secondary">@L["home.noTrend"]</MudText>
                }
                else
                {
                    <MudChart ChartType="ChartType.Line" ChartSeries="@_attendanceSeries"
                              XAxisLabels="@_attendanceLabels" Width="100%" Height="220px"
                              ChartOptions="@(new ChartOptions { YAxisTicks = 20, MaxNumYAxisTicks = 6 })" />
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-2">@L["home.feeTrend"]</MudText>
                <MudChart ChartType="ChartType.Bar" ChartSeries="@_feeSeries"
                          XAxisLabels="@_feeLabels" Width="100%" Height="220px" />
            </MudPaper>
        </MudItem>

        @if (data.BirthdaysToday.Count > 0)
        {
            <MudItem xs="12" md="4">
                <MudPaper Elevation="2" Class="pa-6">
                    <MudText Typo="Typo.h6" Class="mb-3">@L["home.birthdays"]</MudText>
                    @foreach (var birthday in data.BirthdaysToday)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                            <MudAvatar Color="Color.Secondary" Size="Size.Small">
                                @birthday.Name[0]
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2">@birthday.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @(birthday.ClassName ?? "—") · @string.Format(L["home.turns"], birthday.TurnsAge)
                                </MudText>
                            </div>
                        </MudStack>
                    }
                </MudPaper>
            </MudItem>
        }

        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-3">@L["home.upcomingExams"]</MudText>
                @if (data.UpcomingExams.Count == 0)
                {
                    <MudText Class="mud-text-secondary">@L["home.nothingScheduled"]</MudText>
                }
                @foreach (var exam in data.UpcomingExams)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small"
                                 Class="mud-text-secondary" />
                        <MudText>@exam.Name</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @exam.StartDate.ToString("dd MMM yyyy")
                        </MudText>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="@(data.BirthdaysToday.Count > 0 ? 4 : 8)">
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-3">@L["home.needsAttention"]</MudText>
                <MudStack Spacing="2">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="cursor:pointer;"
                              @onclick="@(() => Navigation.NavigateTo("leave"))">
                        <MudChip Size="Size.Small"
                                 Color="@(data.PendingLeaveRequests > 0 ? Color.Warning : Color.Default)">
                            @data.PendingLeaveRequests
                        </MudChip>
                        <MudText>@L["home.pendingLeave"]</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="cursor:pointer;"
                              @onclick="@(() => Navigation.NavigateTo("messages"))">
                        <MudChip Size="Size.Small"
                                 Color="@(data.UnreadParentMessages > 0 ? Color.Error : Color.Default)">
                            @data.UnreadParentMessages
                        </MudChip>
                        <MudText>@L["home.unreadMessages"]</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="cursor:pointer;"
                              @onclick="@(() => Navigation.NavigateTo("admissions"))">
                        <MudChip Size="Size.Small"
                                 Color="@(data.OpenEnquiries > 0 ? Color.Info : Color.Default)">
                            @data.OpenEnquiries
                        </MudChip>
                        <MudText>@L["home.openEnquiries"]</MudText>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Style="cursor:pointer;"
                              @onclick="@(() => Navigation.NavigateTo("admissions"))">
                        <MudChip Size="Size.Small"
                                 Color="@(data.EnquiryFollowUpsDueToday > 0 ? Color.Warning : Color.Default)">
                            @data.EnquiryFollowUpsDueToday
                        </MudChip>
                        <MudText>@L["home.followUpsDue"]</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else
{
    <MudAlert Severity="Severity.Info">
        Sign in with a school account to see the dashboard. Platform (Super Admin)
        accounts manage <MudLink Href="tenants">Schools</MudLink> instead.
    </MudAlert>
}

@code {
    private DashboardDto? _data;
    private bool _loading = true;

    private List<ChartSeries> _attendanceSeries = [];
    private string[] _attendanceLabels = [];
    private List<ChartSeries> _feeSeries = [];
    private string[] _feeLabels = [];

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        try
        {
            _data = await Client.GetAsync();
            if (_data is { } data)
            {
                _attendanceSeries =
                    [new ChartSeries { Name = "%", Data = data.AttendanceTrend.Select(p => (double)p.Value).ToArray() }];
                _attendanceLabels = data.AttendanceTrend
                    .Select((p, i) => i % 3 == 0 ? p.Date.ToString("dd/MM") : "")
                    .ToArray();
                _feeSeries =
                    [new ChartSeries { Name = "₹", Data = data.FeeTrend.Select(p => (double)p.Value).ToArray() }];
                _feeLabels = data.FeeTrend
                    .Select((p, i) => i % 3 == 0 ? p.Date.ToString("dd/MM") : "")
                    .ToArray();
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        catch
        {
            // 403 for platform accounts — the info alert covers it.
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;
}
