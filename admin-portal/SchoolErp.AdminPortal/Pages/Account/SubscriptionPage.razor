@page "/subscription"
@attribute [Authorize]
@inject BillingClient Client
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>Subscription — Akshara</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Subscription</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_data is { } data)
{
    <MudGrid Class="mb-2">
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Plan</MudText>
                <MudText Typo="Typo.h5">@data.Plan</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @(data.ExpiresOn is { } expiry
                        ? $"Renews by {expiry:dd MMM yyyy}"
                        : "No expiry set")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">SMS credits</MudText>
                <MudText Typo="Typo.h5">@data.SmsCredits.ToString("N0")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Contact Akshara for a top-up
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Amount due</MudText>
                <MudText Typo="Typo.h5"
                         Style="@(data.OutstandingTotal > 0 ? "color: var(--mud-palette-warning);" : "")">
                    ₹@data.OutstandingTotal.ToString("N0")
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Elevation="2" Class="pa-4">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Modules enabled</MudText>
                <MudText Typo="Typo.h5">@data.EnabledModules.Count</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.subtitle1" Class="pa-2">Included in your plan</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="pa-2">
            @foreach (var module in data.EnabledModules)
            {
                <MudChip Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                    @module
                </MudChip>
            }
        </MudStack>
    </MudPaper>

    <MudPaper Elevation="2" Class="pa-4">
        <MudText Typo="Typo.subtitle1" Class="pa-2">Invoices from Akshara</MudText>
        <MudTable Items="data.Invoices" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>Number</MudTh>
                <MudTh>Issued</MudTh>
                <MudTh>Due</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Status</MudTh>
                <MudTh />
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    @context.InvoiceNumber
                    @if (context.Lines.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @context.Lines[0].Description
                        </MudText>
                    }
                </MudTd>
                <MudTd>@context.IssuedOn.ToString("dd MMM yyyy")</MudTd>
                <MudTd>@context.DueOn.ToString("dd MMM yyyy")</MudTd>
                <MudTd>₹@context.TotalAmount.ToString("N0")</MudTd>
                <MudTd>
                    <MudChip Size="Size.Small"
                             Color="@(context.Status == InvoiceStatus.Paid ? Color.Success
                                 : context.Status == InvoiceStatus.Void ? Color.Default : Color.Warning)">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                                   Title="Download PDF" OnClick="@(() => DownloadAsync(context))" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Class="mud-text-secondary pa-4">No invoices yet.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
else
{
    <MudAlert Severity="Severity.Info">
        Subscription details are available to school administrator accounts.
    </MudAlert>
}

@code {
    private MySubscriptionDto? _data;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _data = await Client.GetMySubscriptionAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadAsync(InvoiceDto invoice)
    {
        var bytes = await Client.GetMyInvoicePdfAsync(invoice.Id);
        if (bytes is null)
        {
            Snackbar.Add("Could not fetch the PDF.", Severity.Error);
            return;
        }

        await Js.InvokeVoidAsync("schoolErpDownload",
            $"{invoice.InvoiceNumber}.pdf", "application/pdf", Convert.ToBase64String(bytes));
    }
}
