@page "/timetable"
@attribute [Authorize]
@inject TimetableClient Client
@inject AcademicsClient AcademicsApi
@inject ExamsClient ExamsApi
@inject StaffClient StaffApi
@inject InstitutionContext Institution
@inject ISnackbar Snackbar

<PageTitle>Timetable — Akshara</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Timetable</MudText>
    <MudSpacer />
    <MudSelect T="Guid?" @bind-Value="_classId" Label="@Institution.Cohort" Dense="true" Style="min-width: 150px;"
               SelectedValuesChanged="@(_ => OnScopeChangedAsync())">
        @foreach (var schoolClass in _classes)
        {
            <MudSelectItem T="Guid?" Value="@schoolClass.Id">@schoolClass.Name</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="Guid?" @bind-Value="_sectionId" Label="Section" Clearable="true" Dense="true"
               HelperText="Empty = all sections" Style="min-width: 150px;"
               Disabled="@(_classId is null)" SelectedValuesChanged="@(_ => OnScopeChangedAsync())">
        @foreach (var sec in SectionsOfSelectedClass)
        {
            <MudSelectItem T="Guid?" Value="@sec.Id">@sec.Name</MudSelectItem>
        }
    </MudSelect>
</MudStack>

@if (_classId is null)
{
    <MudAlert Severity="Severity.Info">Pick a class to edit its weekly timetable.</MudAlert>
}
else
{
    <MudPaper Elevation="2" Class="pa-6 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">Slots</MudText>
            @if (_rows.Count > 0)
            {
                <MudChip Size="Size.Small" Class="ml-2"
                         Color="@(_allPublished ? Color.Success : Color.Warning)">
                    @(_allPublished ? "Published" : "Draft — parents can't see this yet")
                </MudChip>
            }
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@(() => _rows.Add(new SlotRow()))">
                Add period
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.FreeBreakfast"
                       OnClick="AddBreak">
                Add break
            </MudButton>
        </MudStack>

        @foreach (var (row, index) in _rows.Select((r, i) => (r, i)))
        {
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
                <MudSelect T="int" @bind-Value="row.Day" Label="Day" Dense="true" Style="width: 130px;">
                    @for (var d = 1; d <= 6; d++)
                    {
                        var day = d;
                        <MudSelectItem T="int" Value="@day">@DayNames[day]</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="TimetableSlotKind" @bind-Value="row.Kind" Label="Type" Dense="true"
                           Style="width: 120px;">
                    <MudSelectItem Value="TimetableSlotKind.Lesson">Period</MudSelectItem>
                    <MudSelectItem Value="TimetableSlotKind.Break">Recess</MudSelectItem>
                    <MudSelectItem Value="TimetableSlotKind.Lunch">Lunch</MudSelectItem>
                </MudSelect>
                @if (row.Kind == TimetableSlotKind.Lesson)
                {
                    <MudNumericField @bind-Value="row.Period" Label="Period" Min="1" Max="12"
                                     Style="width: 90px;" />
                }
                <MudTextField @bind-Value="row.Start" Label="Start (HH:mm)" Style="width: 110px;" />
                <MudTextField @bind-Value="row.End" Label="End (HH:mm)" Style="width: 110px;" />
                @if (row.Kind == TimetableSlotKind.Lesson)
                {
                    <MudSelect T="Guid?" @bind-Value="row.SubjectId" Label="Subject" Dense="true"
                               Style="min-width: 160px;">
                        @foreach (var subject in _subjects)
                        {
                            <MudSelectItem T="Guid?" Value="@subject.Id">@subject.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid?" @bind-Value="row.TeacherId" Label="Teacher" Clearable="true"
                               Dense="true" Style="min-width: 170px;">
                        @foreach (var teacher in _teachers)
                        {
                            <MudSelectItem T="Guid?" Value="@teacher.Id">@teacher.FullName</MudSelectItem>
                        }
                    </MudSelect>
                    @if (row.TeacherId is null)
                    {
                        <MudTextField @bind-Value="row.Teacher" Label="Guest teacher (optional)"
                                      Style="min-width: 140px;" />
                    }
                }
                else
                {
                    <MudTextField @bind-Value="row.Label" Label="Name (optional)"
                                  Placeholder="@DefaultBreakLabel(row.Kind)"
                                  HelperText="Shown to parents" Style="min-width: 200px;" />
                }
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => _rows.RemoveAt(index))" />
            </MudStack>
        }

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudSpacer />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy" OnClick="SaveAsync">
                Save draft
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(_busy || _rows.Count == 0)"
                       StartIcon="@Icons.Material.Filled.Publish" OnClick="PublishAsync">
                Publish to parents
            </MudButton>
        </MudStack>
    </MudPaper>

    @if (GridRows.Count > 0)
    {
        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-3">Week view</MudText>
            <div style="overflow-x: auto;">
                <MudSimpleTable Dense="true" Bordered="true" Style="min-width: 760px;">
                    <thead>
                        <tr>
                            <th style="width: 90px;">Period</th>
                            @for (var d = 1; d <= 6; d++)
                            {
                                <th>@DayNames[d]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var gridRow in GridRows)
                        {
                            <tr class="@(gridRow.IsBreak ? "ak-break-row" : "")">
                                <td class="mud-text-secondary">@gridRow.Header</td>
                                @for (var d = 1; d <= 6; d++)
                                {
                                    var slot = SlotAt(gridRow, d);
                                    <td>
                                        @if (slot is not null && gridRow.IsBreak)
                                        {
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                @(BreakLabel(slot))
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @slot.Start–@slot.End
                                            </MudText>
                                        }
                                        else if (slot?.SubjectId is not null)
                                        {
                                            <MudText Typo="Typo.body2" Class="font-weight-bold">
                                                @(_subjects.FirstOrDefault(s => s.Id == slot.SubjectId)?.Name ?? "—")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @slot.Start–@slot.End
                                                @(TeacherLabel(slot) is { } t ? $" · {t}" : "")
                                            </MudText>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        </MudPaper>
    }
}

@code {
    private static readonly string[] DayNames =
        ["", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private sealed class SlotRow
    {
        public int Day { get; set; } = 1;
        public TimetableSlotKind Kind { get; set; } = TimetableSlotKind.Lesson;
        public int Period { get; set; } = 1;
        public string Start { get; set; } = "08:00";
        public string End { get; set; } = "08:45";
        public string? Label { get; set; }
        public Guid? SubjectId { get; set; }
        public Guid? TeacherId { get; set; }
        public string? Teacher { get; set; }
    }

    /// <summary>
    /// One line of the week view. Lessons group by period number; breaks have
    /// no number, so they group by kind and start time and sort in among the
    /// periods by the clock — which is how the day actually runs.
    /// </summary>
    private sealed record GridRow(
        string Header, TimeOnly Sort, bool IsBreak, int? Period, TimetableSlotKind Kind, string? Start);

    private List<SchoolClassDto> _classes = [];
    private List<SubjectDto> _subjects = [];
    private List<TeacherDto> _teachers = [];
    private List<SlotRow> _rows = [];
    private Guid? _classId;
    private Guid? _sectionId;
    private bool _busy;
    private bool _allPublished;

    private IEnumerable<SectionDto> SectionsOfSelectedClass =>
        _classes.FirstOrDefault(c => c.Id == _classId)?.Sections ?? [];

    private List<GridRow> GridRows
    {
        get
        {
            var lessons = _rows
                .Where(r => r.Kind == TimetableSlotKind.Lesson && r.SubjectId is not null)
                .GroupBy(r => r.Period)
                .Select(g => new GridRow(
                    $"P{g.Key}", EarliestStart(g), false, g.Key, TimetableSlotKind.Lesson, null));

            var breaks = _rows
                .Where(r => r.Kind != TimetableSlotKind.Lesson)
                .GroupBy(r => (r.Kind, r.Start))
                .Select(g => new GridRow(
                    BreakLabel(g.First()), EarliestStart(g), true, null, g.Key.Kind, g.Key.Start));

            return lessons.Concat(breaks).OrderBy(r => r.Sort).ToList();
        }
    }

    private static TimeOnly EarliestStart(IEnumerable<SlotRow> rows) =>
        rows.Select(r => TimeOnly.TryParse(r.Start, out var t) ? t : TimeOnly.MaxValue).Min();

    private SlotRow? SlotAt(GridRow gridRow, int day) => gridRow.IsBreak
        ? _rows.FirstOrDefault(r =>
            r.Day == day && r.Kind == gridRow.Kind && r.Start == gridRow.Start)
        : _rows.FirstOrDefault(r =>
            r.Day == day && r.Kind == TimetableSlotKind.Lesson && r.Period == gridRow.Period);

    private static string DefaultBreakLabel(TimetableSlotKind kind) =>
        kind == TimetableSlotKind.Lunch ? "Lunch break" : "Recess";

    private static string BreakLabel(SlotRow row) =>
        string.IsNullOrWhiteSpace(row.Label) ? DefaultBreakLabel(row.Kind) : row.Label.Trim();

    /// <summary>
    /// A new break defaults after the last slot of the day being edited, so the
    /// common case (drop lunch in at the end of the morning) needs no retyping.
    /// </summary>
    private void AddBreak()
    {
        var last = _rows.OrderBy(r => r.Start, StringComparer.Ordinal).LastOrDefault();
        var start = last?.End ?? "10:30";
        var end = TimeOnly.TryParse(start, out var parsed)
            ? parsed.AddMinutes(20).ToString("HH\\:mm")
            : "10:50";
        _rows.Add(new SlotRow
        {
            Day = last?.Day ?? 1,
            Kind = TimetableSlotKind.Break,
            Start = start,
            End = end,
        });
    }

    protected override async Task OnInitializedAsync()
    {
        await Institution.EnsureLoadedAsync();
        try
        {
            _classes = await AcademicsApi.GetClassesAsync();
            _subjects = await ExamsApi.GetSubjectsAsync();
            _teachers = (await StaffApi.GetTeachersAsync()).Where(t => t.IsActive).ToList();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private async Task OnScopeChangedAsync()
    {
        if (_classId is null)
        {
            return;
        }

        List<TimetableEntryDto> entries;
        try
        {
            entries = await Client.GetAsync(_classId.Value, _sectionId);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
            return;
        }

        _allPublished = entries.Count > 0 && entries.All(e => e.IsPublished);
        _rows = entries.Select(e => new SlotRow
        {
            Day = e.DayOfWeek,
            Kind = e.SlotKind,
            Period = e.Period ?? 1,
            Start = e.StartTime.ToString("HH\\:mm"),
            End = e.EndTime.ToString("HH\\:mm"),
            Label = e.Label,
            SubjectId = e.SubjectId,
            TeacherId = e.TeacherId,
            Teacher = e.TeacherId is null ? e.TeacherName : null,
        }).ToList();
        if (_rows.Count == 0)
        {
            _rows.Add(new SlotRow());
        }
    }

    private List<TimetableEntryInput>? BuildEntries()
    {
        var entries = new List<TimetableEntryInput>();
        foreach (var row in _rows)
        {
            if (!TimeOnly.TryParse(row.Start, out var start) ||
                !TimeOnly.TryParse(row.End, out var end))
            {
                Snackbar.Add("Every slot needs valid HH:mm times.", Severity.Warning);
                return null;
            }

            if (row.Kind != TimetableSlotKind.Lesson)
            {
                // A break carries no period, subject or teacher — the server
                // rejects the define outright if any of them is sent.
                entries.Add(new TimetableEntryInput(
                    row.Day, null, start, end, null, null, null,
                    row.Kind,
                    string.IsNullOrWhiteSpace(row.Label) ? null : row.Label.Trim()));
                continue;
            }

            if (row.SubjectId is null)
            {
                Snackbar.Add("Every taught period needs a subject.", Severity.Warning);
                return null;
            }

            entries.Add(new TimetableEntryInput(
                row.Day, row.Period, start, end, row.SubjectId.Value,
                row.TeacherId,
                row.TeacherId is not null || string.IsNullOrWhiteSpace(row.Teacher)
                    ? null
                    : row.Teacher.Trim()));
        }

        return entries;
    }

    private async Task SaveAsync()
    {
        if (_classId is null || BuildEntries() is not { } entries)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.DefineAsync(
                new DefineTimetableRequest(_classId.Value, _sectionId, entries));
            if (error is null)
            {
                Snackbar.Add("Draft saved. Publish when ready.", Severity.Success);
                await OnScopeChangedAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PublishAsync()
    {
        if (_classId is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.PublishAsync(
                new PublishTimetableRequest(_classId.Value, _sectionId));
            if (error is null)
            {
                Snackbar.Add("Timetable published. Parents can now see it.", Severity.Success);
                await OnScopeChangedAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private string? TeacherLabel(SlotRow slot) =>
        slot.TeacherId is { } id
            ? _teachers.FirstOrDefault(t => t.Id == id)?.FullName
            : (string.IsNullOrWhiteSpace(slot.Teacher) ? null : slot.Teacher);
}
