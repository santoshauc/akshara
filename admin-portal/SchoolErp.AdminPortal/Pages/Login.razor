@page "/login"
@layout EmptyLayout
@implements IDisposable
@inject AuthApiClient AuthApi
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject LocalizationService L

<PageTitle>Sign in — Akshara</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center" Style="min-height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width: 100%;">
        <MudStack Spacing="4">
            <MudStack Row="true" Justify="Justify.FlexEnd">
                <MudButton Size="Size.Small" Variant="Variant.Text"
                           OnClick="@(() => L.SetLanguageAsync(L.Language == "en" ? "te" : "en"))">
                    @(L.Language == "en" ? "తెలుగు" : "EN")
                </MudButton>
            </MudStack>
            <MudStack Row="false" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5">Akshara Admin</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(_mfaToken is null ? "Sign in to manage your platform" : "Two-factor verification")
                </MudText>
            </MudStack>

            @if (_mfaToken is null)
            {
                @if (_schools.Count > 0)
                {
                    <MudSelect T="string" @bind-Value="_schoolCode" Label="@L["login.chooseSchool"]"
                               HelperText="@L["login.chooseSchoolHelp"]"
                               Variant="Variant.Outlined">
                        @foreach (var school in _schools)
                        {
                            <MudSelectItem T="string" Value="@school.Code">@school.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                <MudTextField @bind-Value="_login" Label="@L["login.emailOrPhone"]"
                              Variant="Variant.Outlined" Immediate="true" />
                <MudTextField @bind-Value="_password" Label="@L["login.password"]"
                              Variant="Variant.Outlined"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                              Immediate="true"
                              OnKeyDown="@(async e => { if (e.Key == "Enter") await SignInAsync(); })" />
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Enter the 6-digit code from your authenticator app, or one of
                    your recovery codes.
                </MudText>
                <MudTextField @bind-Value="_mfaCode" Label="Verification code"
                              Variant="Variant.Outlined" Immediate="true" AutoFocus="true"
                              OnKeyDown="@(async e => { if (e.Key == "Enter") await VerifyMfaAsync(); })" />
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }

            @if (_mfaToken is null)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           FullWidth="true" Disabled="@_busy" OnClick="SignInAsync">
                    @(_busy ? L["login.signingIn"] : L["login.signIn"])
                </MudButton>
                <MudButton Variant="Variant.Text" FullWidth="true"
                           OnClick="@(() => Navigation.NavigateTo("forgot-password"))">
                    @L["login.forgot"]
                </MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           FullWidth="true" Disabled="@_busy" OnClick="VerifyMfaAsync">
                    @(_busy ? "Verifying…" : "Verify")
                </MudButton>
                <MudButton Variant="Variant.Text" FullWidth="true"
                           OnClick="@(() => { _mfaToken = null; _mfaCode = string.Empty; _error = null; })">
                    Back to password
                </MudButton>
            }
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    protected override async Task OnInitializedAsync()
    {
        await L.InitializeAsync();
        L.Changed += OnLanguageChanged;
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    // Only ever set when the server comes back asking which school — the
    // sign-in form does not ask for a code up front any more.
    private string _schoolCode = string.Empty;
    private List<SchoolChoiceModel> _schools = [];
    private string _login = string.Empty;
    private string _password = string.Empty;
    private string _mfaCode = string.Empty;
    private string? _mfaToken;
    private string? _error;
    private bool _busy;
    private bool _showPassword;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private async Task SignInAsync()
    {
        if (string.IsNullOrWhiteSpace(_login) || string.IsNullOrWhiteSpace(_password))
        {
            _error = "Enter your login and password.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var outcome = await AuthApi.LoginAsync(_schoolCode.Trim(), _login.Trim(), _password);
            if (outcome.NeedsMfa)
            {
                _mfaToken = outcome.MfaToken;
            }
            else if (outcome.Schools.Count > 0)
            {
                // The credentials were right but fit more than one school, so
                // the form grows a picker and the user submits once more.
                _schools = outcome.Schools;
                _schoolCode = outcome.Schools[0].Code;
                _error = L["login.chooseSchoolHelp"];
            }
            else if (outcome.Succeeded)
            {
                // The school code now rides in the token, so the chrome can
                // brand itself without ever having asked for one.
                await AuthApi.RememberSchoolForBrandingAsync();
                Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "" : ReturnUrl);
            }
            else
            {
                _error = outcome.Error;
            }
        }
        catch (HttpRequestException)
        {
            _error = L["login.cannotReach"];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task VerifyMfaAsync()
    {
        if (_mfaToken is null || string.IsNullOrWhiteSpace(_mfaCode))
        {
            _error = "Enter the code from your authenticator app.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            _error = await AuthApi.VerifyMfaAsync(_mfaToken, _mfaCode.Trim());
            if (_error is null)
            {
                Navigation.NavigateTo(string.IsNullOrWhiteSpace(ReturnUrl) ? "" : ReturnUrl);
            }
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the server. Is the API running?";
        }
        finally
        {
            _busy = false;
        }
    }
}
