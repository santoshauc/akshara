@page "/exams"
@attribute [Authorize]
@inject ExamsClient Client
@inject AcademicsClient AcademicsApi
@inject StudentsClient StudentsApi
@inject NavigationManager Navigation
@inject InstitutionContext Institution
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime Js

<PageTitle>Exams — Akshara</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Examinations</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.MenuBook"
               OnClick="@(() => _showSubjectForm = !_showSubjectForm)">
        Add subject
    </MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune"
               OnClick="@(() => _showReportSettings = !_showReportSettings)">
        Report card layout
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => _showExamForm = !_showExamForm)">
        Create exam
    </MudButton>
</MudStack>

@if (_showSubjectForm)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_subjectName" Label="Subject name" Style="min-width: 220px;" />
            <MudTextField @bind-Value="_subjectCode" Label="Code (e.g. MATH)" Style="min-width: 140px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                       OnClick="CreateSubjectAsync">Save subject</MudButton>
            @foreach (var subject in _subjects)
            {
                <MudChip Size="Size.Small" Variant="Variant.Outlined">@subject.Name (@subject.Code)</MudChip>
            }
        </MudStack>
    </MudPaper>
}

@if (_showReportSettings && _reportSettings is not null)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-1">Report card layout</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Applies to every report card this school prints, including the
            copies parents download.
        </MudText>
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSelect T="ReportCardTemplate" @bind-Value="_reportTemplate" Label="Template"
                       Dense="true" Style="min-width: 230px;">
                <MudSelectItem Value="ReportCardTemplate.MarksAndGrades">Marks and grades</MudSelectItem>
                <MudSelectItem Value="ReportCardTemplate.MarksOnly">Marks only</MudSelectItem>
                <MudSelectItem Value="ReportCardTemplate.GradesOnly">Grades only (no marks)</MudSelectItem>
            </MudSelect>
            <MudSwitch @bind-Checked="_reportShowAttendance" Color="Color.Primary"
                       Label="Show attendance" />
            <MudSwitch @bind-Checked="_reportShowRemarks" Color="Color.Primary"
                       Label="Remarks box" />
        </MudStack>
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-2">
            <MudTextField @bind-Value="_reportSignatories" Label="Signature lines (comma separated)"
                          HelperText="Up to four; leave empty for the standard three."
                          Style="min-width: 340px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                       OnClick="SaveReportSettingsAsync">Save layout</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_showExamForm)
{
    <MudPaper Elevation="2" Class="pa-4 mb-4">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_examName" Label="Exam name (e.g. Mid-Term 1)" Style="min-width: 240px;" />
            <MudDatePicker @bind-Date="_examStart" Label="Start" Editable="true" Style="min-width: 150px;" />
            <MudDatePicker @bind-Date="_examEnd" Label="End" Editable="true" Style="min-width: 150px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                       OnClick="CreateExamAsync">Create exam</MudButton>
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_exams.Count == 0)
{
    <MudAlert Severity="Severity.Info">No exams in the current academic year yet.</MudAlert>
}
else
{
    @foreach (var exam in _exams)
    {
        <MudPaper Elevation="2" Class="pa-6 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">@exam.Name</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary ml-2">
                    @exam.StartDate.ToString("dd MMM") – @exam.EndDate.ToString("dd MMM yyyy")
                </MudText>
                <MudChip Size="Size.Small" Class="ml-2"
                         Color="@(exam.Status == ExamStatus.Published ? Color.Success : Color.Info)">
                    @exam.Status
                </MudChip>
                <MudSpacer />
                @if (exam.Status == ExamStatus.Draft)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                               StartIcon="@Icons.Material.Filled.PostAdd"
                               OnClick="@(() => ToggleScheduleForm(exam.Id))">
                        Schedule paper
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Publish" Class="ml-2"
                               OnClick="@(() => PublishAsync(exam))">
                        Publish results
                    </MudButton>
                }
            </MudStack>

            @if (_scheduleFormExamId == exam.Id)
            {
                <MudPaper Outlined="true" Class="pa-4 mb-3">
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudSelect T="Guid?" @bind-Value="_paperClassId" Label="@Institution.Cohort" Style="min-width: 140px;">
                            @foreach (var schoolClass in _classes)
                            {
                                <MudSelectItem T="Guid?" Value="@schoolClass.Id">@schoolClass.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudSelect T="Guid?" @bind-Value="_paperSubjectId" Label="Subject" Style="min-width: 160px;">
                            @foreach (var subject in _subjects)
                            {
                                <MudSelectItem T="Guid?" Value="@subject.Id">@subject.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudDatePicker @bind-Date="_paperDate" Label="Exam date" Editable="true"
                                       Style="min-width: 150px;" />
                        <MudNumericField @bind-Value="_paperMax" Label="Max marks" Min="1" Max="1000"
                                         Style="width: 110px;" />
                        <MudNumericField @bind-Value="_paperPass" Label="Pass marks" Min="0"
                                         Style="width: 110px;" />
                        @if (Institution.IsCollege)
                        {
                            @* Without this the paper carries no credits and
                               contributes nothing to the SGPA. *@
                            <MudNumericField @bind-Value="_paperCredits" Label="Credits"
                                             Min="1" Max="12" Style="width: 110px;"
                                             HelperText="Counts toward SGPA" />
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                                   OnClick="@(() => SchedulePaperAsync(exam.Id))">Add paper</MudButton>
                    </MudStack>
                </MudPaper>
            }

            @if (exam.Subjects.Count == 0)
            {
                <MudText Class="mud-text-secondary">No papers scheduled yet.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true">
                    <thead>
                        <tr>
                            <th>@Institution.Cohort</th>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Max / Pass</th>
                            <th style="width: 140px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var paper in exam.Subjects)
                        {
                            <tr>
                                <td>@paper.ClassName</td>
                                <td>@paper.SubjectName</td>
                                <td>@(paper.ExamDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>@paper.MaxMarks / @paper.PassMarks</td>
                                <td>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.EditNote"
                                               Disabled="@(exam.Status == ExamStatus.Published)"
                                               OnClick="@(() => Navigation.NavigateTo($"exams/papers/{paper.Id}/marks"))">
                                        Marks
                                    </MudButton>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        </MudPaper>
    }
}

<MudPaper Elevation="2" Class="pa-6 mt-4">
    <MudText Typo="Typo.h6" Class="mb-1">Term reports</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Combine exams with weights into a final report card. Enter co-scholastic
        grades and remarks per student, then download the weighted PDF.
    </MudText>

    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
        <MudTextField @bind-Value="_termName" Label="Name (e.g. Annual 2026-27)"
                      Style="min-width: 220px;" />
        @foreach (var (component, index) in _termComponents.Select((c, i) => (c, i)))
        {
            <MudSelect T="Guid?" @bind-Value="component.ExamId" Label="Exam" Dense="true"
                       Style="min-width: 160px;">
                @foreach (var exam in _exams)
                {
                    <MudSelectItem T="Guid?" Value="@exam.Id">@exam.Name</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="decimal" @bind-Value="component.Weight" Label="Weight %"
                             Min="1" Max="100" Style="width: 100px;" HideSpinButtons="true" />
        }
        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                       OnClick="@(() => _termComponents.Add(new TermComponentRow()))" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                   OnClick="CreateTermReportAsync">
            Create term report
        </MudButton>
    </MudStack>

    @foreach (var report in _termReports)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.subtitle1">@report.Name</MudText>
                @foreach (var component in report.Components)
                {
                    <MudChip Size="Size.Small" Variant="Variant.Outlined">
                        @component.ExamName (@component.WeightPercent.ToString("0.#")%)
                    </MudChip>
                }
            </MudStack>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mt-3">
                <MudSelect T="Guid?" @bind-Value="_termStudentId" Label="Student" Dense="true"
                           Style="min-width: 200px;">
                    @foreach (var student in _termStudents)
                    {
                        <MudSelectItem T="Guid?" Value="@student.Id">
                            @student.FirstName @student.LastName
                        </MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_termRemarks" Label="Teacher's remarks"
                              Style="min-width: 260px;" />
                <MudTextField @bind-Value="_termCoScholastic"
                              Label="Co-scholastic (Area:Grade, comma-separated)"
                              HelperText="e.g. Art:A, Sports:B"
                              Style="min-width: 240px;" />
                <MudButton Variant="Variant.Outlined" Disabled="@(_busy || _termStudentId is null)"
                           OnClick="@(() => SaveTermInputAsync(report.Id))">
                    Save
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="@(_busy || _termStudentId is null)"
                           OnClick="@(() => DownloadTermPdfAsync(report.Id))">
                    Report card PDF
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</MudPaper>

@code {
    private List<ExamDto> _exams = [];
    private List<SubjectDto> _subjects = [];
    private List<SchoolClassDto> _classes = [];
    private Guid? _currentYearId;
    private bool _loading = true;
    private bool _busy;

    private bool _showReportSettings;
    private ReportCardSettingsDto? _reportSettings;
    private ReportCardTemplate _reportTemplate = ReportCardTemplate.MarksAndGrades;
    private bool _reportShowAttendance;
    private bool _reportShowRemarks;
    private string _reportSignatories = string.Empty;

    private bool _showSubjectForm;
    private string _subjectName = string.Empty;
    private string _subjectCode = string.Empty;

    private bool _showExamForm;
    private string _examName = string.Empty;
    private DateTime? _examStart = DateTime.Today;
    private DateTime? _examEnd = DateTime.Today.AddDays(7);

    private Guid? _scheduleFormExamId;
    private Guid? _paperClassId;
    private Guid? _paperSubjectId;
    private DateTime? _paperDate;
    private decimal _paperMax = 100;
    private decimal _paperPass = 33;

    /// <summary>Credit weight; only a college is asked for it. 4 is the
    /// commonest weight for an Indian degree paper.</summary>
    private int _paperCredits = 4;

    protected override async Task OnInitializedAsync()
    {
        await Institution.EnsureLoadedAsync();
        try
        {
            var years = await AcademicsApi.GetYearsAsync();
            _currentYearId = years.FirstOrDefault(y => y.IsCurrent)?.Id ?? years.FirstOrDefault()?.Id;
            _subjects = await Client.GetSubjectsAsync();
            await LoadReportSettingsAsync();
            _classes = await AcademicsApi.GetClassesAsync();
            await ReloadExamsAsync();
            await ReloadTermReportsAsync();
            _termStudents = (await StudentsApi.GetStudentsAsync(
                null, null, null, StudentStatus.Active, 1, 100)).Items.ToList();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ReloadExamsAsync()
    {
        if (_currentYearId is { } yearId)
        {
            _exams = await Client.GetExamsAsync(yearId);
        }
    }

    private sealed class TermComponentRow
    {
        public Guid? ExamId { get; set; }
        public decimal Weight { get; set; } = 50;
    }

    private List<TermReportDto> _termReports = [];
    private List<StudentListItemDto> _termStudents = [];
    private readonly List<TermComponentRow> _termComponents = [new(), new()];
    private string _termName = string.Empty;
    private Guid? _termStudentId;
    private string? _termRemarks;
    private string? _termCoScholastic;

    private async Task ReloadTermReportsAsync()
    {
        if (_currentYearId is { } yearId)
        {
            _termReports = await Client.GetTermReportsAsync(yearId);
        }
    }

    private async Task CreateTermReportAsync()
    {
        var components = _termComponents
            .Where(c => c.ExamId is not null)
            .Select(c => new TermReportComponentInput(c.ExamId!.Value, c.Weight))
            .ToList();
        if (_currentYearId is null || string.IsNullOrWhiteSpace(_termName) || components.Count == 0)
        {
            Snackbar.Add("Name and at least one weighted exam are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateTermReportAsync(
                _currentYearId.Value, _termName.Trim(), components);
            if (error is null)
            {
                Snackbar.Add("Term report created.", Severity.Success);
                _termName = string.Empty;
                await ReloadTermReportsAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveTermInputAsync(Guid termReportId)
    {
        if (_termStudentId is null)
        {
            return;
        }

        // "Art:A, Sports:B" → area/grade pairs; malformed chunks are skipped.
        var coScholastic = (_termCoScholastic ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(pair => pair.Split(':', 2, StringSplitOptions.TrimEntries))
            .Where(parts => parts.Length == 2 && parts[0].Length > 0 && parts[1].Length > 0)
            .ToDictionary(parts => parts[0], parts => parts[1]);

        _busy = true;
        try
        {
            var error = await Client.SetTermStudentInputAsync(
                termReportId, _termStudentId.Value, coScholastic,
                string.IsNullOrWhiteSpace(_termRemarks) ? null : _termRemarks.Trim());
            Snackbar.Add(error ?? "Saved.", error is null ? Severity.Success : Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DownloadTermPdfAsync(Guid termReportId)
    {
        if (_termStudentId is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var pdf = await Client.GetTermReportPdfAsync(termReportId, _termStudentId.Value);
            if (pdf is null)
            {
                Snackbar.Add("Could not generate the report card.", Severity.Error);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                "term-report.pdf", "application/pdf", Convert.ToBase64String(pdf));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateSubjectAsync()
    {
        if (string.IsNullOrWhiteSpace(_subjectName) || string.IsNullOrWhiteSpace(_subjectCode))
        {
            Snackbar.Add("Subject name and code are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateSubjectAsync(new CreateSubjectRequest(
                _subjectName.Trim(), _subjectCode.Trim().ToUpperInvariant()));
            if (error is null)
            {
                Snackbar.Add("Subject created.", Severity.Success);
                _subjectName = _subjectCode = string.Empty;
                _subjects = await Client.GetSubjectsAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateExamAsync()
    {
        if (string.IsNullOrWhiteSpace(_examName) || _examStart is null || _examEnd is null ||
            _currentYearId is null)
        {
            Snackbar.Add("Exam name and dates are required (and an academic year must exist).", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateExamAsync(new CreateExamRequest(
                _examName.Trim(), _currentYearId.Value,
                DateOnly.FromDateTime(_examStart.Value), DateOnly.FromDateTime(_examEnd.Value)));
            if (error is null)
            {
                Snackbar.Add("Exam created.", Severity.Success);
                _showExamForm = false;
                _examName = string.Empty;
                await ReloadExamsAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private void ToggleScheduleForm(Guid examId) =>
        _scheduleFormExamId = _scheduleFormExamId == examId ? null : examId;

    private async Task SchedulePaperAsync(Guid examId)
    {
        if (_paperClassId is null || _paperSubjectId is null)
        {
            Snackbar.Add("Pick a class and subject.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.SchedulePaperAsync(examId, new SchedulePaperRequest(
                _paperClassId.Value, _paperSubjectId.Value,
                _paperDate is null ? null : DateOnly.FromDateTime(_paperDate.Value),
                _paperMax, _paperPass,
                Institution.IsCollege ? _paperCredits : null));
            if (error is null)
            {
                Snackbar.Add("Paper scheduled.", Severity.Success);
                await ReloadExamsAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PublishAsync(ExamDto exam)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Publish results",
            $"Publish '{exam.Name}'? Marks will be frozen and parents will be notified by SMS.",
            yesText: "Publish", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var error = await Client.PublishAsync(exam.Id);
        if (error is null)
        {
            Snackbar.Add("Results published. Parent notifications queued.", Severity.Success);
            await ReloadExamsAsync();
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private async Task LoadReportSettingsAsync()
    {
        _reportSettings = await Client.GetReportCardSettingsAsync();
        if (_reportSettings is null)
        {
            return;
        }

        _reportTemplate = _reportSettings.Template;
        _reportShowAttendance = _reportSettings.ShowAttendance;
        _reportShowRemarks = _reportSettings.ShowRemarks;
        _reportSignatories = string.Join(", ", _reportSettings.Signatories);
    }

    private async Task SaveReportSettingsAsync()
    {
        _busy = true;
        try
        {
            var signatories = _reportSignatories
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            var error = await Client.UpdateReportCardSettingsAsync(new ReportCardSettingsDto(
                _reportTemplate, _reportShowAttendance, _reportShowRemarks, signatories));
            if (error is null)
            {
                Snackbar.Add("Report card layout saved.", Severity.Success);
                await LoadReportSettingsAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
