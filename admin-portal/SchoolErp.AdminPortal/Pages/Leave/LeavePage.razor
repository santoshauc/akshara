@page "/leave"
@attribute [Authorize]
@implements IDisposable
@inject LeaveClient Client
@inject ISnackbar Snackbar
@inject LocalizationService L

<PageTitle>@L["leave.title"] — Akshara</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">@L["leave.requestsTitle"]</MudText>
    <MudSpacer />
    @* Values stay English — they are the API's filter vocabulary. Only the
       display text localizes, and ToStringFunc keeps the CLOSED select
       localized too (it would otherwise echo the raw bound value). *@
    <MudSelect T="string" @bind-Value="_statusFilter" Label="@L["common.status"]" Dense="true"
               Style="width: 150px;" SelectedValuesChanged="@(_ => LoadAsync())"
               ToStringFunc="@FilterLabel">
        <MudSelectItem T="string" Value="@("Pending")">@L["leave.filterPending"]</MudSelectItem>
        <MudSelectItem T="string" Value="@("Approved")">@L["leave.filterApproved"]</MudSelectItem>
        <MudSelectItem T="string" Value="@("Rejected")">@L["leave.filterRejected"]</MudSelectItem>
        <MudSelectItem T="string" Value="@("all")">@L["leave.filterAll"]</MudSelectItem>
    </MudSelect>
</MudStack>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudTable Items="_requests" Dense="true" Hover="true" Loading="_loading">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="@(new Func<LeaveRequestDto, object>(l => l.ApplicantName))">@L["leave.applicant"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<LeaveRequestDto, object>(l => l.Kind))">@L["leave.type"]</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<LeaveRequestDto, object>(l => l.FromDate))">@L["leave.dates"]</MudTableSortLabel></MudTh>
            <MudTh>@L["leave.reason"]</MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<LeaveRequestDto, object>(l => l.Status))">@L["common.status"]</MudTableSortLabel></MudTh>
            <MudTh />
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @context.ApplicantName
                @if (context.ClassName is { } className)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary"> @className</MudText>
                }
            </MudTd>
            <MudTd>@(context.Kind == LeaveApplicantKind.Student ? L["leave.kindStudent"] : L["leave.kindStaff"])</MudTd>
            <MudTd>
                @context.FromDate.ToString("dd MMM")–@context.ToDate.ToString("dd MMM yyyy")
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @L.Format("leave.daysCount", context.ToDate.DayNumber - context.FromDate.DayNumber + 1)
                </MudText>
            </MudTd>
            <MudTd Style="max-width: 260px;">@context.Reason</MudTd>
            <MudTd>
                <MudChip Size="Size.Small" Color="@StatusColor(context.Status)">
                    @StatusLabel(context.Status)
                </MudChip>
                @if (context.DecisionNote is { } note)
                {
                    <MudTooltip Text="@note">
                        <MudIcon Icon="@Icons.Material.Filled.Comment" Size="Size.Small"
                                 Class="mud-text-secondary ml-1" />
                    </MudTooltip>
                }
            </MudTd>
            <MudTd>
                @if (context.Status == LeaveRequestStatus.Pending)
                {
                    <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                               Disabled="_busy" OnClick="@(() => DecideAsync(context, true))">
                        @L["common.approve"]
                    </MudButton>
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                               Class="ml-1" Disabled="_busy"
                               OnClick="@(() => DecideAsync(context, false))">
                        @L["common.reject"]
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary pa-4">@L["leave.none"]</MudText>
        </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
    </MudTable>
</MudPaper>

<MudPaper Elevation="2" Class="pa-6">
    <MudText Typo="Typo.h6" Class="mb-1">@L["leave.mine"]</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["leave.mineHelp"]</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudDatePicker @bind-Date="_myFrom" Label="@L["leave.from"]" Editable="true" Style="width: 160px;" />
        <MudDatePicker @bind-Date="_myTo" Label="@L["leave.to"]" Editable="true" Style="width: 160px;" />
        <MudTextField @bind-Value="_myReason" Label="@L["leave.reason"]" Style="min-width: 260px;" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                   OnClick="SubmitMineAsync">
            @L["leave.request"]
        </MudButton>
    </MudStack>

    @if (_mine.Count > 0)
    {
        <MudList T="LeaveRequestDto" Dense="true" Class="mt-3">
            @foreach (var mine in _mine)
            {
                <MudListItem T="LeaveRequestDto">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudChip Size="Size.Small" Color="@StatusColor(mine.Status)">@StatusLabel(mine.Status)</MudChip>
                        <MudText Typo="Typo.body2">
                            @mine.FromDate.ToString("dd MMM")–@mine.ToDate.ToString("dd MMM yyyy")
                            · @mine.Reason
                        </MudText>
                        @if (mine.DecisionNote is { } mineNote)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">(@mineNote)</MudText>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    }
</MudPaper>

@code {
    private List<LeaveRequestDto> _requests = [];
    private List<LeaveRequestDto> _mine = [];
    private string _statusFilter = "Pending";
    private DateTime? _myFrom;
    private DateTime? _myTo;
    private string _myReason = string.Empty;
    private bool _loading = true;
    private bool _busy;

    protected override Task OnInitializedAsync()
    {
        // The layout re-rendering does NOT re-render @Body pages — each
        // localized page subscribes itself or the toggle appears dead here.
        L.Changed += OnLanguageChanged;
        return LoadAsync();
    }

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    private static Color StatusColor(LeaveRequestStatus status) => status switch
    {
        LeaveRequestStatus.Approved => Color.Success,
        LeaveRequestStatus.Rejected => Color.Error,
        _ => Color.Warning,
    };

    private string StatusLabel(LeaveRequestStatus status) => status switch
    {
        LeaveRequestStatus.Approved => L["leave.filterApproved"],
        LeaveRequestStatus.Rejected => L["leave.filterRejected"],
        _ => L["leave.filterPending"],
    };

    private string FilterLabel(string? value) => value switch
    {
        "Approved" => L["leave.filterApproved"],
        "Rejected" => L["leave.filterRejected"],
        "all" => L["leave.filterAll"],
        _ => L["leave.filterPending"],
    };

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _requests = await Client.GetRequestsAsync(
                _statusFilter == "all" ? null : _statusFilter);
            _mine = await Client.GetMineAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["common.cannotReach"], Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DecideAsync(LeaveRequestDto request, bool approve)
    {
        _busy = true;
        try
        {
            var error = await Client.DecideAsync(request.Id, approve, null);
            if (error is null)
            {
                Snackbar.Add(
                    approve
                        ? request.Kind == LeaveApplicantKind.Student
                            ? L.Format("leave.approvedStudent", request.ApplicantName)
                            : L["leave.approved"]
                        : L["leave.rejected"],
                    approve ? Severity.Success : Severity.Info);
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["common.cannotReach"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SubmitMineAsync()
    {
        if (_myFrom is null || _myTo is null || string.IsNullOrWhiteSpace(_myReason))
        {
            Snackbar.Add(L["leave.needDatesReason"], Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.SubmitMineAsync(
                DateOnly.FromDateTime(_myFrom.Value),
                DateOnly.FromDateTime(_myTo.Value),
                _myReason.Trim());
            if (error is null)
            {
                Snackbar.Add(L["leave.submitted"], Severity.Success);
                _myReason = string.Empty;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["common.cannotReach"], Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
