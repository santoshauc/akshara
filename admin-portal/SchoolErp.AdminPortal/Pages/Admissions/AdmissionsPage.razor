@page "/admissions"
@attribute [Authorize]
@inject AdmissionsClient Client
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Admissions — SchoolErp</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Admissions</MudText>
    <MudSpacer />
    <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Dense="true"
               Style="width: 150px;" SelectedValuesChanged="@(_ => LoadAsync())">
        <MudSelectItem T="string" Value="@("open")">Open</MudSelectItem>
        <MudSelectItem T="string" Value="@("New")">New</MudSelectItem>
        <MudSelectItem T="string" Value="@("Contacted")">Contacted</MudSelectItem>
        <MudSelectItem T="string" Value="@("Visit")">Visit</MudSelectItem>
        <MudSelectItem T="string" Value="@("Admitted")">Admitted</MudSelectItem>
        <MudSelectItem T="string" Value="@("Lost")">Lost</MudSelectItem>
        <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
    </MudSelect>
</MudStack>

@if (_dueCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Dense="true">
        @_dueCount follow-up@(_dueCount == 1 ? "" : "s") due — highlighted below.
    </MudAlert>
}

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudTable Items="_visible" Dense="true" Hover="true" Loading="_loading"
              RowStyleFunc="@((e, _) => e.FollowUpDue ? "background: rgba(255,152,0,0.08);" : "")">
        <HeaderContent>
            <MudTh>Child</MudTh>
            <MudTh>Class</MudTh>
            <MudTh>Parent</MudTh>
            <MudTh>Source</MudTh>
            <MudTh>Follow-up</MudTh>
            <MudTh>Status</MudTh>
            <MudTh />
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @context.ChildName
                @if (context.DateOfBirth is { } dob)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        b. @dob.ToString("dd MMM yyyy")
                    </MudText>
                }
            </MudTd>
            <MudTd>@context.AppliedClass</MudTd>
            <MudTd>
                @context.ParentName
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @context.Phone @(context.Email is null ? "" : $"· {context.Email}")
                </MudText>
            </MudTd>
            <MudTd>@context.Source</MudTd>
            <MudTd>
                @if (context.FollowUpOn is { } due)
                {
                    <MudText Typo="Typo.body2"
                             Color="@(context.FollowUpDue ? Color.Warning : Color.Default)">
                        @due.ToString("dd MMM yyyy")@(context.FollowUpDue ? " — due" : "")
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
            </MudTd>
            <MudTd>
                <MudChip Size="Size.Small" Color="@StatusColor(context.Status)">
                    @context.Status
                </MudChip>
            </MudTd>
            <MudTd Style="white-space: nowrap;">
                @if (context.Status is not (EnquiryStatus.Admitted or EnquiryStatus.Lost))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_busy"
                               OnClick="@(() => OpenEdit(context))">
                        Update
                    </MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                               Class="ml-1" Disabled="_busy"
                               OnClick="@(() => ConvertToAdmission(context))">
                        Convert
                    </MudButton>
                }
                else if (context.StudentId is { } studentId)
                {
                    <MudLink Href="@($"students/{studentId}")">View student</MudLink>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary pa-4">
                No enquiries yet — register the first one below.
            </MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_editing is { } editing)
{
    <MudPaper Elevation="2" Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Update — @editing.ChildName</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudSelect T="EnquiryStatus" @bind-Value="_editStatus" Label="Status" Dense="true"
                       Style="width: 160px;">
                <MudSelectItem T="EnquiryStatus" Value="EnquiryStatus.New">New</MudSelectItem>
                <MudSelectItem T="EnquiryStatus" Value="EnquiryStatus.Contacted">Contacted</MudSelectItem>
                <MudSelectItem T="EnquiryStatus" Value="EnquiryStatus.Visit">Visit</MudSelectItem>
                <MudSelectItem T="EnquiryStatus" Value="EnquiryStatus.Lost">Lost</MudSelectItem>
            </MudSelect>
            <MudDatePicker @bind-Date="_editFollowUp" Label="Next follow-up" Editable="true"
                           Clearable="true" Style="width: 180px;" />
            <MudTextField @bind-Value="_editNotes" Label="Notes" Style="min-width: 280px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                       OnClick="SaveEditAsync">
                Save
            </MudButton>
            <MudButton Disabled="_busy" OnClick="@(() => _editing = null)">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}

<MudPaper Elevation="2" Class="pa-6">
    <MudText Typo="Typo.h6" Class="mb-1">New enquiry</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Capture the first contact; work it through Contacted → Visit and convert
        when the family admits.
    </MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_childName" Label="Child's name" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_dateOfBirth" Label="Date of birth (optional)"
                           OpenTo="OpenTo.Year" MaxDate="DateTime.Today" Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_appliedClass" Label="Class applied for" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_parentName" Label="Parent's name" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_phone" Label="Phone (+91…)" Required="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_email" Label="Email (optional)" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudSelect T="EnquirySource" @bind-Value="_source" Label="Source">
                <MudSelectItem T="EnquirySource" Value="EnquirySource.WalkIn">Walk-in</MudSelectItem>
                <MudSelectItem T="EnquirySource" Value="EnquirySource.Phone">Phone</MudSelectItem>
                <MudSelectItem T="EnquirySource" Value="EnquirySource.Website">Website</MudSelectItem>
                <MudSelectItem T="EnquirySource" Value="EnquirySource.Referral">Referral</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudDatePicker @bind-Date="_followUpOn" Label="Follow-up on (optional)" Editable="true" />
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudTextField @bind-Value="_notes" Label="Notes (optional)" />
        </MudItem>
        <MudItem xs="12" Class="d-flex justify-end">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                       OnClick="CreateAsync">
                Register enquiry
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@code {
    private List<EnquiryDto> _enquiries = [];
    private string _statusFilter = "open";
    private bool _loading = true;
    private bool _busy;
    private int _dueCount;

    private EnquiryDto? _editing;
    private EnquiryStatus _editStatus;
    private DateTime? _editFollowUp;
    private string? _editNotes;

    private string _childName = string.Empty;
    private DateTime? _dateOfBirth;
    private string _appliedClass = string.Empty;
    private string _parentName = string.Empty;
    private string _phone = string.Empty;
    private string? _email;
    private EnquirySource _source = EnquirySource.WalkIn;
    private DateTime? _followUpOn;
    private string? _notes;

    // "open" is a client-side view over the full board; real statuses filter server-side.
    private IEnumerable<EnquiryDto> _visible => _statusFilter == "open"
        ? _enquiries.Where(e => e.Status is not (EnquiryStatus.Admitted or EnquiryStatus.Lost))
        : _enquiries;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static Color StatusColor(EnquiryStatus status) => status switch
    {
        EnquiryStatus.Admitted => Color.Success,
        EnquiryStatus.Lost => Color.Default,
        EnquiryStatus.New => Color.Info,
        _ => Color.Warning,
    };

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _enquiries = await Client.GetEnquiriesAsync(
                _statusFilter is "all" or "open" ? null : Enum.Parse<EnquiryStatus>(_statusFilter));
            _dueCount = _enquiries.Count(e => e.FollowUpDue);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEdit(EnquiryDto enquiry)
    {
        _editing = enquiry;
        _editStatus = enquiry.Status;
        _editFollowUp = enquiry.FollowUpOn?.ToDateTime(TimeOnly.MinValue);
        _editNotes = enquiry.Notes;
    }

    private async Task SaveEditAsync()
    {
        if (_editing is not { } editing)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.UpdateAsync(
                editing.Id, _editStatus,
                _editFollowUp is { } f ? DateOnly.FromDateTime(f) : null, _editNotes);
            if (error is null)
            {
                Snackbar.Add("Enquiry updated.", Severity.Success);
                _editing = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Hands off to the admission form pre-filled from the enquiry.</summary>
    private void ConvertToAdmission(EnquiryDto enquiry) =>
        Navigation.NavigateTo(
            "students/admit" +
            $"?enquiryId={enquiry.Id}" +
            $"&child={Uri.EscapeDataString(enquiry.ChildName)}" +
            (enquiry.DateOfBirth is { } dob ? $"&dob={dob:yyyy-MM-dd}" : "") +
            $"&parent={Uri.EscapeDataString(enquiry.ParentName)}" +
            $"&phone={Uri.EscapeDataString(enquiry.Phone)}" +
            (enquiry.Email is { } email ? $"&email={Uri.EscapeDataString(email)}" : ""));

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_childName) || string.IsNullOrWhiteSpace(_appliedClass) ||
            string.IsNullOrWhiteSpace(_parentName) || string.IsNullOrWhiteSpace(_phone))
        {
            Snackbar.Add("Child, class, parent and phone are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateAsync(new CreateEnquiryRequest(
                _childName.Trim(),
                _dateOfBirth is { } dob ? DateOnly.FromDateTime(dob) : null,
                _appliedClass.Trim(),
                _parentName.Trim(),
                _phone.Trim(),
                string.IsNullOrWhiteSpace(_email) ? null : _email.Trim(),
                _source,
                _followUpOn is { } f ? DateOnly.FromDateTime(f) : null,
                string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));
            if (error is null)
            {
                Snackbar.Add($"Enquiry for {_childName.Trim()} registered.", Severity.Success);
                _childName = _appliedClass = _parentName = _phone = string.Empty;
                _email = _notes = null;
                _dateOfBirth = _followUpOn = null;
                _source = EnquirySource.WalkIn;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
