@page "/students"
@attribute [Authorize]
@inject StudentsClient Client
@inject AcademicsClient AcademicsApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>Students — Akshara</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Students</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Download"
               OnClick="ExportAsync">
        Export
    </MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.UploadFile"
               OnClick="@(() => _importOpen = !_importOpen)">
        Import from Excel
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => Navigation.NavigateTo("students/admit"))">
        Admit student
    </MudButton>
</MudStack>

@if (_importOpen)
{
    <MudPaper Elevation="2" Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-1">Bulk import from Excel</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            1. Download the template — it lists this school's classes and sections.
            2. Fill one student per row. 3. Upload the file. Nothing is imported
            unless every row is valid, so a half-filled school can never happen.
        </MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                       Disabled="_importBusy" OnClick="DownloadTemplateAsync">
                Download template
            </MudButton>
            <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync"
                           Accept=".xlsx" MaximumFileCount="1" Class="mt-0">
                <ButtonTemplate>
                    <MudButton HtmlTag="label" for="@context.Id"
                               Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.UploadFile"
                               Disabled="_importBusy">
                        @(_importBusy ? "Importing…" : "Upload filled template")
                    </MudButton>
                </ButtonTemplate>
            </MudFileUpload>
        </MudStack>

        @if (_importResult is { } result)
        {
            @if (result.Errors.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Class="mt-3">
                    Imported @result.Imported student(s). They appear in the list below;
                    guardians can sign in to the parent app with their phone numbers.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">
                    @(result.Imported == 0
                        ? $"Nothing was imported — fix the rows below and upload the file again ({result.Errors.Count} problem(s) in {result.TotalRows} row(s))."
                        : $"Imported {result.Imported} of {result.TotalRows}; the rows below failed.")
                </MudAlert>
                <MudSimpleTable Dense="true" Class="mt-2">
                    <thead>
                        <tr><th style="width: 90px;">Row</th><th>Problem</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var error in result.Errors)
                        {
                            <tr><td>@error.RowNumber</td><td>@error.Message</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
    </MudPaper>
}

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudTextField @bind-Value="_search" Label="Search name or admission no."
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" DebounceInterval="400"
                      OnDebounceIntervalElapsed="ReloadAsync" Style="min-width: 260px;" />
        <MudSelect T="Guid?" @bind-Value="_classId" Label="Class" Clearable="true"
                   Style="min-width: 160px;" SelectedValuesChanged="@(_ => OnClassChangedAsync())">
            @foreach (var schoolClass in _classes)
            {
                <MudSelectItem T="Guid?" Value="@schoolClass.Id">@schoolClass.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" @bind-Value="_sectionId" Label="Section" Clearable="true"
                   Style="min-width: 140px;" Disabled="@(_classId is null)"
                   SelectedValuesChanged="@(_ => ReloadAsync())">
            @foreach (var sec in SectionsOfSelectedClass)
            {
                <MudSelectItem T="Guid?" Value="@sec.Id">@sec.Name</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="StudentStatus?" @bind-Value="_status" Label="Status" Clearable="true"
                   Style="min-width: 160px;" SelectedValuesChanged="@(_ => ReloadAsync())">
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Active">Active</MudSelectItem>
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Suspended">Suspended</MudSelectItem>
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Withdrawn">Withdrawn</MudSelectItem>
            <MudSelectItem T="StudentStatus?" Value="StudentStatus.Alumni">Alumni</MudSelectItem>
        </MudSelect>
    </MudStack>
</MudPaper>

<MudTable T="StudentListItemDto" ServerData="LoadServerDataAsync" @ref="_table" Hover="true" Elevation="2"
          OnRowClick="@(args => Navigation.NavigateTo($"students/{args.Item!.Id}"))" Style="cursor: pointer;">
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel T="StudentListItemDto" SortLabel="admissionNumber">
                Admission no.
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="StudentListItemDto" SortLabel="name" InitialDirection="SortDirection.Ascending">
                Name
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="StudentListItemDto" SortLabel="class">Class</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="StudentListItemDto" SortLabel="section">Section</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="StudentListItemDto" SortLabel="roll">Roll</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel T="StudentListItemDto" SortLabel="status">Status</MudTableSortLabel>
        </MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Admission no.">
            <MudText Typo="Typo.body2" Class="font-weight-bold">@context.AdmissionNumber</MudText>
        </MudTd>
        <MudTd DataLabel="Name">@context.FirstName @context.LastName</MudTd>
        <MudTd DataLabel="Class">@(context.ClassName ?? "—")</MudTd>
        <MudTd DataLabel="Section">@(context.SectionName ?? "—")</MudTd>
        <MudTd DataLabel="Roll">@(context.RollNumber?.ToString() ?? "—")</MudTd>
        <MudTd DataLabel="Status">
            <MudChip Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Class="pa-6">No students found. Admit the first one.</MudText>
    </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 20, 50 }" />
    </PagerContent>
</MudTable>

@code {
    private MudTable<StudentListItemDto>? _table;
    private List<SchoolClassDto> _classes = [];
    private string _search = string.Empty;
    private Guid? _classId;
    private Guid? _sectionId;
    private StudentStatus? _status;
    private bool _importOpen;
    private bool _importBusy;
    private ImportStudentsResultDto? _importResult;
    private string? _sortBy;
    private bool _sortDesc;

    private async Task DownloadTemplateAsync()
    {
        try
        {
            var bytes = await Client.GetImportTemplateAsync();
            if (bytes is null)
            {
                Snackbar.Add("Could not fetch the template.", Severity.Error);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                "student-import-template.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private async Task UploadAsync(IBrowserFile? file)
    {
        if (file is null)
        {
            return;
        }

        _importBusy = true;
        _importResult = null;
        try
        {
            await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var (result, error) = await Client.ImportAsync(stream, file.Name);
            if (result is null)
            {
                Snackbar.Add(error ?? "Import failed.", Severity.Error);
                return;
            }

            _importResult = result;
            if (result.Errors.Count == 0)
            {
                Snackbar.Add($"Imported {result.Imported} student(s).", Severity.Success);
                await ReloadAsync();
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _importBusy = false;
        }
    }

    private IEnumerable<SectionDto> SectionsOfSelectedClass =>
        _classes.FirstOrDefault(c => c.Id == _classId)?.Sections ?? [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _classes = await AcademicsApi.GetClassesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private async Task<TableData<StudentListItemDto>> LoadServerDataAsync(TableState state)
    {
        _sortBy = state.SortDirection == SortDirection.None ? null : state.SortLabel;
        _sortDesc = state.SortDirection == SortDirection.Descending;
        try
        {
            var result = await Client.GetStudentsAsync(
                _search, _classId, _sectionId, _status,
                state.Page + 1, state.PageSize == 0 ? 20 : state.PageSize,
                _sortBy, _sortDesc);
            return new TableData<StudentListItemDto> { Items = result.Items, TotalItems = result.TotalCount };
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
            return new TableData<StudentListItemDto> { Items = [], TotalItems = 0 };
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            var bytes = await Client.ExportAsync(
                _search, _classId, _sectionId, _status, _sortBy, _sortDesc);
            if (bytes is null)
            {
                Snackbar.Add("Could not build the export.", Severity.Error);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                "students.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private Task ReloadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    private async Task OnClassChangedAsync()
    {
        _sectionId = null;
        await ReloadAsync();
    }

    private static Color StatusColor(StudentStatus status) => status switch
    {
        StudentStatus.Active => Color.Success,
        StudentStatus.Suspended => Color.Warning,
        StudentStatus.Withdrawn => Color.Default,
        _ => Color.Info,
    };
}
