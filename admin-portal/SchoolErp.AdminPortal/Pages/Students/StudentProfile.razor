@page "/students/{Id:guid}"
@attribute [Authorize]
@inject StudentsClient Client
@inject AttendanceClient AttendanceApi
@inject ExamsClient ExamsApi
@inject InstitutionContext Institution
@inject AcademicsClient AcademicsApi
@inject FeesClient FeesApi
@inject InsightsClient InsightsApi
@inject TransportClient TransportApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IJSRuntime Js

<PageTitle>Student — Akshara</PageTitle>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_student is { } student)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                       OnClick="@(() => Navigation.NavigateTo("students"))" />
        <MudAvatar Color="Color.Primary" Size="Size.Large"
                   Image="@Client.FileUrl(student.PhotoUrl)">
            @student.FirstName[0]@(student.LastName.Length > 0 ? student.LastName[0] : ' ')
        </MudAvatar>
        <div>
            <MudText Typo="Typo.h4">@student.FirstName @student.LastName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @student.AdmissionNumber · admitted @student.AdmissionDate.ToString("dd MMM yyyy")
            </MudText>
        </div>
        <InputFile id="student-photo-input" OnChange="UploadPhotoAsync"
                   accept=".jpg,.jpeg,.png,.webp" hidden />
        <MudButton HtmlTag="label" for="student-photo-input" Size="Size.Small"
                   Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.PhotoCamera"
                   Disabled="@_photoBusy">
            @(_photoBusy ? "Uploading…" : "Photo")
        </MudButton>
        <MudSpacer />
        <MudChip Color="@(student.Status == StudentStatus.Active ? Color.Success : Color.Warning)">
            @student.Status
        </MudChip>
    </MudStack>

    <MudStack Row="true" Spacing="2" Class="mb-4" Wrap="Wrap.Wrap">
        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Description"
                   Disabled="@(_documentBusy is not null)"
                   OnClick="@(() => DownloadDocumentAsync("bonafide-certificate"))">
            @(_documentBusy == "bonafide-certificate" ? "Preparing…" : "Bonafide certificate")
        </MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Badge"
                   Disabled="@(_documentBusy is not null)"
                   OnClick="@(() => DownloadDocumentAsync("id-card"))">
            @(_documentBusy == "id-card" ? "Preparing…" : "ID card")
        </MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.TransferWithinAStation"
                   Disabled="@(_documentBusy is not null)"
                   OnClick="@(() => DownloadDocumentAsync("transfer-certificate"))">
            @(_documentBusy == "transfer-certificate" ? "Preparing…" : "Transfer certificate")
        </MudButton>
        <MudSpacer />
        <MudButton Size="Size.Small" Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.DownloadForOffline"
                   OnClick="ExportDpdpAsync">
            DPDP export
        </MudButton>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.DeleteForever"
                   OnClick="@(() => _eraseOpen = !_eraseOpen)">
            Erase data
        </MudButton>
    </MudStack>

    @if (_eraseOpen)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-4" Style="border-color: var(--mud-palette-error);">
            <MudText Typo="Typo.subtitle1" Color="Color.Error" Class="mb-1">
                DPDP erasure — irreversible
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Personal data is anonymized in place, the photo is deleted, messages
                and leave reasons are redacted, and the student disappears from every
                list. Academic records stay as anonymous rows. The request is audited.
            </MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_eraseReason"
                              Label="Reason (e.g. parent request dated …)"
                              Style="min-width: 320px;" />
                <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@_payBusy"
                           OnClick="EraseDpdpAsync">
                    Erase permanently
                </MudButton>
                <MudButton OnClick="@(() => _eraseOpen = false)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    <MudGrid Spacing="4">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-4">Details</MudText>
                <MudSimpleTable Dense="true" Bordered="false" Elevation="0">
                    <tbody>
                        <tr><td class="mud-text-secondary">Date of birth</td><td>@student.DateOfBirth.ToString("dd MMM yyyy")</td></tr>
                        <tr><td class="mud-text-secondary">Gender</td><td>@student.Gender</td></tr>
                        <tr><td class="mud-text-secondary">Blood group</td><td>@(student.BloodGroup ?? "—")</td></tr>
                        <tr><td class="mud-text-secondary">Address</td><td>@(FormatAddress(student))</td></tr>
                        <tr><td class="mud-text-secondary">Medical notes</td><td>@(student.MedicalNotes ?? "—")</td></tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudPaper Elevation="2" Class="pa-6 mb-4">
                <MudText Typo="Typo.h6" Class="mb-4">Current placement</MudText>
                @if (student.CurrentEnrollment is { } enrollment)
                {
                    <MudStack Row="true" Spacing="4">
                        <MudChip Color="Color.Primary" Variant="Variant.Outlined">@enrollment.AcademicYearName</MudChip>
                        <MudChip Variant="Variant.Outlined">@enrollment.ClassName — @enrollment.SectionName</MudChip>
                        @if (enrollment.RollNumber is { } roll)
                        {
                            <MudChip Variant="Variant.Outlined">Roll @roll</MudChip>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Class="mud-text-secondary">Not enrolled in any academic year.</MudText>
                }
            </MudPaper>

            @if (_month is { MarkedDays: > 0 } month)
            {
                <MudPaper Elevation="2" Class="pa-6 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-4">
                        Attendance — @(new DateOnly(month.Year, month.Month, 1).ToString("MMMM yyyy"))
                    </MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap">
                        <MudProgressCircular Value="@month.AttendancePercent" Color="Color.Success"
                                             Size="Size.Large">
                            <MudText Typo="Typo.caption">@month.AttendancePercent%</MudText>
                        </MudProgressCircular>
                        <MudChip Size="Size.Small" Color="Color.Success">Present @month.PresentCount</MudChip>
                        <MudChip Size="Size.Small" Color="Color.Error">Absent @month.AbsentCount</MudChip>
                        <MudChip Size="Size.Small" Color="Color.Warning">Late @month.LateCount</MudChip>
                        @if (month.LeaveCount > 0)
                        {
                            <MudChip Size="Size.Small">Leave @month.LeaveCount</MudChip>
                        }
                    </MudStack>
                </MudPaper>
            }

            @if (Institution.IsCollege && _gradeSheet is { } sheet)
            {
                @* The cumulative record a university asks for: every published
                   semester, its SGPA, and the CGPA across them. *@
                <MudPaper Elevation="2" Class="pa-6 mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">Grade sheet</MudText>
                        @if (sheet.ProgrammeName is { } programme)
                        {
                            <MudChip Size="Size.Small" Variant="Variant.Outlined">@programme</MudChip>
                        }
                        <MudSpacer />
                        @if (sheet.Cgpa is { } cgpa)
                        {
                            <MudText Typo="Typo.h5">CGPA @cgpa.ToString("0.00")</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                       StartIcon="@Icons.Material.Filled.Download"
                                       Disabled="@_transcriptBusy"
                                       OnClick="DownloadTranscriptAsync">
                                @(_transcriptBusy ? "Preparing…" : "Download")
                            </MudButton>
                        }
                    </MudStack>

                    @if (sheet.Unavailable is { } reason)
                    {
                        @* Says which problem it is — no results yet, or nobody
                           set credits — instead of showing a blank panel. *@
                        <AkEmptyState Title="No GPA to show"
                                      Icon="@Icons.Material.Outlined.Calculate"
                                      Description="@reason" />
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @sheet.CreditsEarned of @sheet.CreditsAttempted credits earned ·
                            UGC 10-point scale
                        </MudText>

                        @foreach (var semester in sheet.Semesters)
                        {
                            <MudPaper Outlined="true" Class="pa-4 mt-3">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2"
                                          Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.subtitle1">@semester.CohortName</MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        @semester.ExamName · @semester.EndDate.ToString("MMM yyyy")
                                    </MudText>
                                    <MudSpacer />
                                    <MudText Typo="Typo.subtitle1">
                                        SGPA @(semester.Sgpa?.ToString("0.00") ?? "—")
                                    </MudText>
                                </MudStack>
                                <MudSimpleTable Dense="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th>Paper</th>
                                            <th style="width: 80px;">Credits</th>
                                            <th style="width: 90px;">Marks</th>
                                            <th style="width: 80px;">Grade</th>
                                            <th style="width: 80px;">Points</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var paper in semester.Papers)
                                        {
                                            <tr>
                                                <td>@paper.SubjectName</td>
                                                <td>@(paper.Credits == 0 ? "—" : paper.Credits.ToString())</td>
                                                <td>
                                                    @(paper.IsAbsent
                                                        ? "Absent"
                                                        : paper.Percent is { } pct ? $"{pct:0.#}%" : "—")
                                                </td>
                                                <td>
                                                    <MudChip Size="Size.Small"
                                                             Color="@(paper.GradePoint == 0 ? Color.Error : Color.Default)">
                                                        @paper.Grade
                                                    </MudChip>
                                                </td>
                                                <td>@paper.GradePoint</td>
                                            </tr>
                                        }
                                    </tbody>
                                </MudSimpleTable>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @semester.CreditsEarned of @semester.CreditsAttempted credits earned
                                </MudText>
                            </MudPaper>
                        }
                    }
                </MudPaper>
            }

            @if (_exams.Count > 0)
            {
                <MudPaper Elevation="2" Class="pa-6 mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6">Report card</MudText>
                        <MudSpacer />
                        <MudSelect T="Guid?" @bind-Value="_selectedExamId" Label="Exam" Dense="true"
                                   Style="min-width: 200px;"
                                   SelectedValuesChanged="@(_ => LoadResultAsync())">
                            @foreach (var exam in _exams)
                            {
                                <MudSelectItem T="Guid?" Value="@exam.Id">@exam.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudStack>

                    @if (_result is { } result)
                    {
                        <MudSimpleTable Dense="true">
                            <thead>
                                <tr><th>Subject</th><th>Marks</th><th>Grade</th><th>Result</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var line in result.Lines)
                                {
                                    <tr>
                                        <td>@line.SubjectName</td>
                                        <td>@(line.IsAbsent ? "Absent" : $"{line.MarksObtained} / {line.MaxMarks}")</td>
                                        <td>@line.Grade</td>
                                        <td>
                                            <MudChip Size="Size.Small"
                                                     Color="@(line.Passed ? Color.Success : Color.Error)">
                                                @(line.Passed ? "Pass" : "Fail")
                                            </MudChip>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                        <MudStack Row="true" Spacing="2" Class="mt-4" Wrap="Wrap.Wrap">
                            <MudChip Color="Color.Primary">
                                Total @result.TotalObtained / @result.TotalMax
                            </MudChip>
                            <MudChip Color="Color.Primary" Variant="Variant.Outlined">@result.Percent%</MudChip>
                            <MudChip Color="Color.Secondary">Grade @result.OverallGrade</MudChip>
                            @if (result.SectionRank is { } rank)
                            {
                                <MudChip Variant="Variant.Outlined">
                                    Rank @rank of @result.SectionSize
                                </MudChip>
                            }
                            @if (result.ExamStatus != ExamStatus.Published)
                            {
                                <MudChip Size="Size.Small" Color="Color.Warning">Unpublished — staff preview</MudChip>
                            }
                        </MudStack>
                    }
                    else if (_selectedExamId is not null)
                    {
                        <MudText Class="mud-text-secondary">No marks recorded for this exam.</MudText>
                    }
                </MudPaper>
            }

            @if (_insights is { } insights &&
                 (insights.Subjects.Count > 0 || insights.ClassAttendancePercent is not null))
            {
                <MudPaper Elevation="2" Class="pa-6 mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                        <MudText Typo="Typo.h6">Peer comparison</MudText>
                        <MudSpacer />
                        @if (insights.Rank is { } peerRank && insights.SectionSize is { } size)
                        {
                            <MudChip Size="Size.Small" Variant="Variant.Outlined">
                                Rank @peerRank of @size
                            </MudChip>
                        }
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                        @(insights.ExamName is { } examName
                            ? $"Against the section average for {examName} — aggregates only, no other student is named."
                            : "Against the section average — aggregates only, no other student is named.")
                    </MudText>
                    @foreach (var subject in insights.Subjects)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">@subject.Subject</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressLinear Color="Color.Primary" Value="@((double)subject.ChildPercent)"
                                               Style="height: 10px; border-radius: 5px;" />
                            <MudText Typo="Typo.caption" Style="min-width: 110px;">
                                Student @subject.ChildPercent.ToString("0.#")%
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressLinear Color="Color.Default" Value="@((double)subject.ClassAverage)"
                                               Style="height: 10px; border-radius: 5px;" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width: 110px;">
                                Class avg @subject.ClassAverage.ToString("0.#")%
                            </MudText>
                        </MudStack>
                    }
                    @if (insights.ChildAttendancePercent is { } childAtt &&
                         insights.ClassAttendancePercent is { } classAtt)
                    {
                        <MudText Typo="Typo.body2" Class="mt-3">Attendance this month</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressLinear Color="Color.Primary" Value="@((double)childAtt)"
                                               Style="height: 10px; border-radius: 5px;" />
                            <MudText Typo="Typo.caption" Style="min-width: 110px;">
                                Student @childAtt.ToString("0.#")%
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudProgressLinear Color="Color.Default" Value="@((double)classAtt)"
                                               Style="height: 10px; border-radius: 5px;" />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="min-width: 110px;">
                                Class avg @classAtt.ToString("0.#")%
                            </MudText>
                        </MudStack>
                    }
                </MudPaper>
            }

            @if (_fees is { } fees)
            {
                <MudPaper Elevation="2" Class="pa-6 mb-4">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                        <MudText Typo="Typo.h6">Fees</MudText>
                        <MudSpacer />
                        <MudChip Color="@(fees.Balance <= 0 ? Color.Success : Color.Warning)">
                            Balance ₹@fees.Balance.ToString("N0")
                        </MudChip>
                    </MudStack>

                    <MudSimpleTable Dense="true" Class="mb-3">
                        <thead>
                            <tr><th>Head</th><th>Amount</th><th>Late fine</th><th>Due date</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var line in fees.DueLines)
                            {
                                <tr>
                                    <td>
                                        @line.FeeHeadName
                                        @if (line.Label is { } label)
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-1">— @label</MudText>
                                        }
                                    </td>
                                    <td>₹@line.Amount.ToString("N0")</td>
                                    <td>@(line.LateFine > 0 ? $"₹{line.LateFine:N0}" : "—")</td>
                                    <td>
                                        @line.DueDate.ToString("dd MMM yyyy")
                                        @if (line.Overdue)
                                        {
                                            <MudChip Size="Size.Small" Color="Color.Error" Class="ml-1">Overdue</MudChip>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (fees.Concessions.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Concessions</MudText>
                        @foreach (var concession in fees.Concessions)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Discount" Size="Size.Small"
                                         Color="Color.Success" />
                                <MudText Typo="Typo.body2">
                                    −₹@concession.Amount.ToString("N0")
                                    @(concession.FeeHeadName is { } headName ? $" on {headName}" : "")
                                    · @concession.Reason
                                </MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                               title="Revoke concession"
                                               OnClick="@(() => RevokeConcessionAsync(concession.Id))" />
                            </MudStack>
                        }
                    }

                    @if (fees.Payments.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Payments</MudText>
                        @foreach (var payment in fees.Payments)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small"
                                         Class="mud-text-secondary" />
                                <MudText Typo="Typo.body2">
                                    @payment.ReceiptNumber · ₹@payment.Amount.ToString("N0")
                                    · @payment.Mode · @payment.PaidOn.ToString("dd MMM yyyy")
                                </MudText>
                                <MudSpacer />
                                <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                               title="Download receipt PDF"
                                               OnClick="@(() => DownloadReceiptAsync(payment))" />
                            </MudStack>
                        }
                    }

                    @if (_family is { } family && family.Children.Count > 1)
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            Family ledger
                            <MudChip Size="Size.Small" Class="ml-1"
                                     Color="@(family.FamilyBalance > 0 ? Color.Warning : Color.Success)">
                                Family balance ₹@family.FamilyBalance.ToString("N0")
                            </MudChip>
                        </MudText>
                        @foreach (var sibling in family.Children)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom"
                                         Size="Size.Small" Class="mud-text-secondary" />
                                @if (sibling.StudentId == Id)
                                {
                                    <MudText Typo="Typo.body2">
                                        @sibling.StudentName (this student) · @sibling.ClassName
                                    </MudText>
                                }
                                else
                                {
                                    <MudLink Typo="Typo.body2"
                                             Href="@($"students/{sibling.StudentId}")">
                                        @sibling.StudentName · @sibling.ClassName
                                    </MudLink>
                                }
                                <MudSpacer />
                                <MudText Typo="Typo.body2"
                                         Color="@(sibling.Balance > 0 ? Color.Warning : Color.Success)">
                                    ₹@sibling.Balance.ToString("N0")
                                </MudText>
                            </MudStack>
                        }
                    }

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Grant concession</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudNumericField T="decimal" @bind-Value="_concessionAmount" Label="Amount (₹)"
                                         Min="1" Style="width: 130px;" HideSpinButtons="true" />
                        <MudTextField @bind-Value="_concessionReason" Label="Reason (e.g. Sibling discount)"
                                      Style="min-width: 220px;" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="@_payBusy"
                                   OnClick="GrantConcessionAsync">
                            Grant
                        </MudButton>
                    </MudStack>

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Record payment</MudText>
                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                        <MudNumericField T="decimal" @bind-Value="_payAmount" Label="Amount (₹)" Min="1"
                                         Style="width: 130px;" HideSpinButtons="true" />
                        <MudSelect T="PaymentMode" @bind-Value="_payMode" Label="Mode" Dense="true"
                                   Style="width: 120px;">
                            <MudSelectItem Value="PaymentMode.Cash">Cash</MudSelectItem>
                            <MudSelectItem Value="PaymentMode.Cheque">Cheque</MudSelectItem>
                            <MudSelectItem Value="PaymentMode.Upi">UPI</MudSelectItem>
                        </MudSelect>
                        <MudTextField @bind-Value="_payReference" Label="Reference" Style="width: 160px;" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_payBusy"
                                   OnClick="RecordPaymentAsync">
                            @(_payBusy ? "Saving…" : "Collect")
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }

            <MudPaper Elevation="2" Class="pa-6 mb-4">
                <MudText Typo="Typo.h6" Class="mb-3">Transport</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudSelect T="Guid?" @bind-Value="_transportRouteId" Label="Route" Dense="true"
                               Style="min-width: 180px;" SelectedValuesChanged="@(_ => _transportStopId = null)">
                        @foreach (var route in _routes)
                        {
                            <MudSelectItem T="Guid?" Value="@route.Id">@route.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="Guid?" @bind-Value="_transportStopId" Label="Stop" Dense="true"
                               Style="min-width: 170px;" Disabled="@(_transportRouteId is null)">
                        @foreach (var stop in StopsOfSelectedRoute)
                        {
                            <MudSelectItem T="Guid?" Value="@stop.Id">@stop.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_transportBusy"
                               OnClick="AssignTransportAsync">
                        @(_transportBusy ? "Saving…" : "Assign")
                    </MudButton>
                </MudStack>
            </MudPaper>

            <MudPaper Elevation="2" Class="pa-6">
                <MudText Typo="Typo.h6" Class="mb-4">Guardians</MudText>
                @foreach (var guardian in student.Guardians)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mud-text-secondary" />
                        <div>
                            <MudText>
                                @guardian.FirstName @guardian.LastName
                                <MudText Typo="Typo.caption" Class="mud-text-secondary" Inline="true">
                                    (@guardian.Relation)
                                </MudText>
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @guardian.Phone @(guardian.Email is not null ? $"· {guardian.Email}" : "")
                            </MudText>
                        </div>
                        <MudSpacer />
                        <MudSelect T="string" Value="@guardian.PreferredLanguage" Dense="true"
                                   Label="SMS language" Style="max-width: 150px;"
                                   Disabled="@(_languageBusy == guardian.Id)"
                                   ValueChanged="@(lang => SetGuardianLanguageAsync(guardian.Id, lang))">
                            <MudSelectItem Value="@("en")">English</MudSelectItem>
                            <MudSelectItem Value="@("te")">తెలుగు</MudSelectItem>
                        </MudSelect>
                        @if (guardian.IsPrimary)
                        {
                            <MudChip Size="Size.Small" Color="Color.Info">Primary</MudChip>
                        }
                    </MudStack>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Absence, fee, result and bus alerts are sent in each guardian's own language.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private StudentDetailDto? _student;
    private StudentMonthAttendanceDto? _month;
    private List<ExamDto> _exams = [];
    private Guid? _selectedExamId;
    private StudentResultDto? _result;
    private StudentFeeSummaryDto? _fees;
    private FamilyFeeSummaryDto? _family;
    private List<TransportRouteDto> _routes = [];
    private Guid? _transportRouteId;
    private Guid? _transportStopId;
    private bool _transportBusy;
    private Guid? _currentYearId;

    private IEnumerable<RouteStopDto> StopsOfSelectedRoute =>
        _routes.FirstOrDefault(r => r.Id == _transportRouteId)?.Stops ?? [];
    private decimal _payAmount = 1000;
    private PaymentMode _payMode = PaymentMode.Cash;
    private string? _payReference;
    private bool _payBusy;
    private bool _photoBusy;
    private Guid? _languageBusy;
    private bool _loading = true;
    private StudentInsightsDto? _insights;

    /// <summary>Cumulative record; only a college has one.</summary>
    private GradeSheetDto? _gradeSheet;
    private bool _transcriptBusy;

    private async Task DownloadTranscriptAsync()
    {
        _transcriptBusy = true;
        try
        {
            var pdf = await ExamsApi.GetTranscriptAsync(Id);
            if (pdf is null)
            {
                Snackbar.Add("There is nothing to print on this grade sheet yet.", Severity.Warning);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                $"grade-sheet-{_student?.AdmissionNumber ?? Id.ToString()}.pdf",
                "application/pdf",
                Convert.ToBase64String(pdf));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _transcriptBusy = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            await Institution.EnsureLoadedAsync();
            _student = await Client.GetStudentAsync(Id);
            if (Institution.IsCollege)
            {
                _gradeSheet = await ExamsApi.GetGradeSheetAsync(Id);
            }
            var today = DateTime.Today;
            _month = await AttendanceApi.GetStudentMonthAsync(Id, today.Year, today.Month);

            var years = await AcademicsApi.GetYearsAsync();
            var currentYear = years.FirstOrDefault(y => y.IsCurrent) ?? years.FirstOrDefault();
            if (currentYear is not null)
            {
                _currentYearId = currentYear.Id;
                _exams = await ExamsApi.GetExamsAsync(currentYear.Id);
                _selectedExamId = _exams.FirstOrDefault()?.Id;
                await LoadResultAsync();
                _fees = await FeesApi.GetStudentSummaryAsync(Id, currentYear.Id);
                _family = await FeesApi.GetFamilyAsync(Id);
                _insights = await InsightsApi.GetStudentAsync(Id);
            }

            _routes = await TransportApi.GetRoutesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// Saves immediately — a select that needed a separate Save button would
    /// leave the office unsure whether the parent's language actually changed.
    /// </summary>
    private async Task SetGuardianLanguageAsync(Guid guardianId, string language)
    {
        _languageBusy = guardianId;
        try
        {
            var error = await Client.SetGuardianLanguageAsync(guardianId, language);
            if (error is not null)
            {
                Snackbar.Add(error, Severity.Error);
                return;
            }

            _student = await Client.GetStudentAsync(Id);
            Snackbar.Add(
                language == "te" ? "Alerts to this guardian will be in Telugu."
                                 : "Alerts to this guardian will be in English.",
                Severity.Success);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _languageBusy = null;
        }
    }

    private string? _documentBusy;
    private decimal _concessionAmount = 1000;
    private string? _concessionReason;
    private bool _eraseOpen;
    private string? _eraseReason;

    private async Task ExportDpdpAsync()
    {
        try
        {
            var json = await Client.ExportDataAsync(Id);
            if (json is null)
            {
                Snackbar.Add("Could not generate the export.", Severity.Error);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                $"dpdp-export-{_student?.AdmissionNumber ?? Id.ToString()}.json",
                "application/json", Convert.ToBase64String(json));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private async Task EraseDpdpAsync()
    {
        if (string.IsNullOrWhiteSpace(_eraseReason))
        {
            Snackbar.Add("A reason is required — it is the paper trail.", Severity.Warning);
            return;
        }

        _payBusy = true;
        try
        {
            var error = await Client.EraseDataAsync(Id, _eraseReason.Trim());
            if (error is null)
            {
                Snackbar.Add("Personal data erased and audited.", Severity.Success);
                Navigation.NavigateTo("students");
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _payBusy = false;
        }
    }

    private async Task DownloadReceiptAsync(FeePaymentDto payment)
    {
        try
        {
            var pdf = await FeesApi.GetReceiptAsync(payment.Id);
            if (pdf is null)
            {
                Snackbar.Add("Could not generate the receipt.", Severity.Error);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                $"receipt-{payment.ReceiptNumber}.pdf", "application/pdf",
                Convert.ToBase64String(pdf));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private async Task GrantConcessionAsync()
    {
        if (_currentYearId is null || _concessionAmount <= 0 ||
            string.IsNullOrWhiteSpace(_concessionReason))
        {
            Snackbar.Add("Amount and reason are required.", Severity.Warning);
            return;
        }

        _payBusy = true;
        try
        {
            var error = await FeesApi.GrantConcessionAsync(new GrantConcessionRequest(
                Id, _currentYearId.Value, null, _concessionAmount, _concessionReason.Trim()));
            if (error is null)
            {
                Snackbar.Add("Concession granted.", Severity.Success);
                _concessionReason = null;
                _fees = await FeesApi.GetStudentSummaryAsync(Id, _currentYearId.Value);
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _payBusy = false;
        }
    }

    private async Task RevokeConcessionAsync(Guid concessionId)
    {
        if (_currentYearId is null)
        {
            return;
        }

        var error = await FeesApi.RevokeConcessionAsync(concessionId);
        if (error is null)
        {
            Snackbar.Add("Concession revoked.", Severity.Info);
            _fees = await FeesApi.GetStudentSummaryAsync(Id, _currentYearId.Value);
        }
        else
        {
            Snackbar.Add(error, Severity.Error);
        }
    }

    private async Task DownloadDocumentAsync(string type)
    {
        _documentBusy = type;
        try
        {
            var pdf = await Client.GetDocumentAsync(Id, type);
            if (pdf is null)
            {
                Snackbar.Add("Could not generate the document.", Severity.Error);
                return;
            }

            await Js.InvokeVoidAsync("schoolErpDownload",
                $"{type}-{_student?.AdmissionNumber ?? Id.ToString()}.pdf",
                "application/pdf",
                Convert.ToBase64String(pdf));
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _documentBusy = null;
        }
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        const long maxBytes = 2 * 1024 * 1024;
        if (e.File.Size > maxBytes)
        {
            Snackbar.Add("Photo must be 2 MB or smaller.", Severity.Warning);
            return;
        }

        _photoBusy = true;
        try
        {
            await using var content = e.File.OpenReadStream(maxBytes);
            var (photoUrl, error) = await Client.UploadPhotoAsync(
                Id, e.File.Name, content, e.File.ContentType);
            if (photoUrl is not null && _student is not null)
            {
                _student = _student with { PhotoUrl = photoUrl };
                Snackbar.Add("Photo updated. Parents see it in the app.", Severity.Success);
            }
            else
            {
                Snackbar.Add(error ?? "Upload failed.", Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _photoBusy = false;
        }
    }

    private async Task LoadResultAsync()
    {
        _result = _selectedExamId is { } examId
            ? await ExamsApi.GetStudentResultAsync(examId, Id)
            : null;
    }

    private async Task RecordPaymentAsync()
    {
        if (_currentYearId is null || _payAmount <= 0)
        {
            return;
        }

        _payBusy = true;
        try
        {
            var (receipt, error) = await FeesApi.RecordPaymentAsync(new RecordPaymentRequest(
                Id, _currentYearId.Value, _payAmount,
                DateOnly.FromDateTime(DateTime.Today), _payMode,
                string.IsNullOrWhiteSpace(_payReference) ? null : _payReference.Trim(), null));
            if (receipt is not null)
            {
                Snackbar.Add($"Collected ₹{receipt.Amount:N0} — receipt {receipt.ReceiptNumber}. " +
                    "SMS confirmation queued.", Severity.Success);
                _payReference = null;
                _fees = await FeesApi.GetStudentSummaryAsync(Id, _currentYearId.Value);
            }
            else
            {
                Snackbar.Add(error ?? "Payment failed.", Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _payBusy = false;
        }
    }

    private async Task AssignTransportAsync()
    {
        if (_transportRouteId is null || _transportStopId is null)
        {
            Snackbar.Add("Pick a route and stop.", Severity.Warning);
            return;
        }

        _transportBusy = true;
        try
        {
            var error = await TransportApi.AssignStudentAsync(new AssignTransportRequest(
                Id, _transportRouteId.Value, _transportStopId.Value));
            Snackbar.Add(
                error ?? "Transport assigned. Parents see it in the app.",
                error is null ? Severity.Success : Severity.Error);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _transportBusy = false;
        }
    }

    private static string FormatAddress(StudentDetailDto student)
    {
        var parts = new[] { student.AddressLine1, student.City, student.State, student.PostalCode }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var joined = string.Join(", ", parts);
        return joined.Length == 0 ? "—" : joined;
    }
}
