@page "/notices"
@attribute [Authorize]
@implements IDisposable
@inject CommsClient Client
@inject AcademicsClient AcademicsApi
@inject ISnackbar Snackbar
@inject LocalizationService L

<PageTitle>@L["notices.title"] — Akshara</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">@L["notices.title"]</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Campaign"
               OnClick="@(() => _showForm = !_showForm)">
        @L["notices.publish"]
    </MudButton>
</MudStack>

@if (_showForm)
{
    <MudPaper Elevation="2" Class="pa-6 mb-4">
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_title" Label="@L["common.title"]" />
            <MudTextField @bind-Value="_body" Label="@L["notices.message"]" Lines="4" />
            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudSelect T="Guid?" @bind-Value="_classId" Label="@L["notices.audience"]" Clearable="true"
                           HelperText="@L["notices.wholeSchoolHint"]" Style="min-width: 200px;">
                    @foreach (var schoolClass in _classes)
                    {
                        <MudSelectItem T="Guid?" Value="@schoolClass.Id">@L.Format("notices.classOnly", schoolClass.Name)</MudSelectItem>
                    }
                </MudSelect>
                <MudDatePicker @bind-Date="_expires" Label="@L["notices.expires"]" Editable="true"
                               Style="min-width: 170px;" />
                <MudCheckBox T="bool" @bind-Value="_pinned" Label="@L["notices.pin"]" />
                <MudSpacer />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                           OnClick="PublishAsync">
                    @(_busy ? L["notices.publishing"] : L["notices.publishBtn"])
                </MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@if (_notices.Count == 0)
{
    <MudAlert Severity="Severity.Info">@L["notices.none"]</MudAlert>
}
else
{
    @foreach (var notice in _notices)
    {
        <MudPaper Elevation="2" Class="pa-4 mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
                @if (notice.IsPinned)
                {
                    <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Color="Color.Warning" />
                }
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@notice.Title</MudText>
                <MudSpacer />
                <MudChip Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(notice.SchoolClassId is null ? Color.Primary : Color.Secondary)">
                    @(notice.ClassName ?? L["notices.wholeSchool"])
                </MudChip>
            </MudStack>
            <MudText Typo="Typo.body2">@notice.Body</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                @notice.PublishedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                @(notice.ExpiresOn is { } expiry ? L.Format("notices.expiresOn", expiry.ToString("dd MMM yyyy")) : "")
            </MudText>
        </MudPaper>
    }
}

@code {
    private List<NoticeDto> _notices = [];
    private List<SchoolClassDto> _classes = [];
    private bool _showForm;
    private bool _busy;

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;
    private string _title = string.Empty;
    private string _body = string.Empty;
    private Guid? _classId;
    private DateTime? _expires;
    private bool _pinned;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        try
        {
            _classes = await AcademicsApi.GetClassesAsync();
            _notices = await Client.GetNoticesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["common.cannotReach"], Severity.Error);
        }
    }

    private async Task PublishAsync()
    {
        if (string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_body))
        {
            Snackbar.Add(L["notices.needTitleBody"], Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateNoticeAsync(new CreateNoticeRequest(
                _title.Trim(), _body.Trim(), _classId,
                _expires is null ? null : DateOnly.FromDateTime(_expires.Value), _pinned));
            if (error is null)
            {
                Snackbar.Add(L["notices.published"], Severity.Success);
                _showForm = false;
                _title = _body = string.Empty;
                _classId = null;
                _expires = null;
                _pinned = false;
                _notices = await Client.GetNoticesAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
