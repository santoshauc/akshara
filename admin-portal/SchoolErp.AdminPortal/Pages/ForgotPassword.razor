@page "/forgot-password"
@layout EmptyLayout
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Reset password — SchoolErp</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="d-flex align-center" Style="min-height: 100vh;">
    <MudPaper Elevation="4" Class="pa-8" Style="width: 100%;">
        <MudStack Spacing="4">
            <MudStack AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.LockReset" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5">Reset your password</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(_stage == Stage.Details
                        ? "We'll SMS a code to the phone on your account."
                        : "Enter the code from the SMS and a new password.")
                </MudText>
            </MudStack>

            @if (_stage == Stage.Details)
            {
                <MudTextField @bind-Value="_schoolCode" Label="School code" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_login" Label="Email or phone" Variant="Variant.Outlined" />
            }
            else
            {
                <MudTextField @bind-Value="_code" Label="6-digit code" Variant="Variant.Outlined" />
                <MudTextField @bind-Value="_newPassword" Label="New password"
                              InputType="InputType.Password" Variant="Variant.Outlined" />
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            @if (_info is not null)
            {
                <MudAlert Severity="Severity.Info" Dense="true">@_info</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       FullWidth="true" Disabled="@_busy"
                       OnClick="@(_stage == Stage.Details ? SendCodeAsync : ResetAsync)">
                @(_busy ? "Working…" : _stage == Stage.Details ? "Send code" : "Reset password")
            </MudButton>
            <MudButton Variant="Variant.Text" FullWidth="true"
                       OnClick="@(() => Navigation.NavigateTo("login"))">
                Back to sign in
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private enum Stage { Details, Code }

    private Stage _stage = Stage.Details;
    private string _schoolCode = "";
    private string _login = "";
    private string _code = "";
    private string _newPassword = "";
    private string? _error;
    private string? _info;
    private bool _busy;

    private async Task SendCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_schoolCode) || string.IsNullOrWhiteSpace(_login))
        {
            _error = "Enter your school code and login.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Http.PostAsJsonAsync("api/v1/auth/password/forgot",
                new { schoolCode = _schoolCode.Trim(), login = _login.Trim() });
            _info = "If the account exists, a code has been sent by SMS.";
            _stage = Stage.Code;
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the server.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync()
    {
        if (_code.Trim().Length != 6 || _newPassword.Length < 8)
        {
            _error = "Enter the 6-digit code and a password of at least 8 characters.";
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/v1/auth/password/reset", new
            {
                schoolCode = _schoolCode.Trim(),
                login = _login.Trim(),
                code = _code.Trim(),
                newPassword = _newPassword,
            });
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("login");
            }
            else
            {
                _error = "The code is invalid or expired.";
            }
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the server.";
        }
        finally
        {
            _busy = false;
        }
    }
}
