@page "/fees"
@attribute [Authorize]
@implements IDisposable
@inject FeesClient Client
@inject AcademicsClient AcademicsApi
@inject InstitutionContext Institution
@inject ISnackbar Snackbar
@inject LocalizationService L

<PageTitle>@L["fees.title"] — Akshara</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">@L["fees.setupTitle"]</MudText>

<MudGrid Spacing="4">
    <MudItem xs="12" md="4">
        <MudPaper Elevation="2" Class="pa-6">
            <MudText Typo="Typo.h6" Class="mb-4">@L["fees.heads"]</MudText>
            <MudStack Spacing="2" Class="mb-3">
                <MudTextField @bind-Value="_newHeadName" Label="@L["fees.newHead"]" />
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudSelect T="LateFineType" @bind-Value="_newHeadFineType" Label="@L["fees.lateFine"]"
                               Dense="true" Style="width: 130px;">
                        <MudSelectItem Value="LateFineType.None">@L["fees.fineNone"]</MudSelectItem>
                        <MudSelectItem Value="LateFineType.Flat">@L["fees.fineFlat"]</MudSelectItem>
                        <MudSelectItem Value="LateFineType.Percent">@L["fees.finePercent"]</MudSelectItem>
                    </MudSelect>
                    @if (_newHeadFineType != LateFineType.None)
                    {
                        <MudNumericField T="decimal" @bind-Value="_newHeadFineValue"
                                         Label="@(_newHeadFineType == LateFineType.Flat ? "₹" : "%")"
                                         Min="0" Style="width: 100px;" HideSpinButtons="true" />
                    }
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                               OnClick="CreateHeadAsync">@L["fees.add"]</MudButton>
                </MudStack>
            </MudStack>
            @foreach (var head in _heads)
            {
                <MudChip Size="Size.Small" Variant="Variant.Outlined" Class="ma-1">
                    @head.Name@(head.LateFineType == LateFineType.Flat
                        ? L.Format("fees.lateFlat", head.LateFineValue.ToString("N0"))
                        : head.LateFineType == LateFineType.Percent
                            ? L.Format("fees.latePercent", head.LateFineValue.ToString("0.#"))
                            : "")
                </MudChip>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Elevation="2" Class="pa-6">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
                <MudText Typo="Typo.h6">@L["fees.planTitle"]</MudText>
                <MudSpacer />
                <MudSelect T="Guid?" @bind-Value="_classId" Label="@Institution.Cohort" Dense="true"
                           Style="min-width: 160px;" SelectedValuesChanged="@(_ => LoadPlanAsync())">
                    @foreach (var schoolClass in _classes)
                    {
                        <MudSelectItem T="Guid?" Value="@schoolClass.Id">@schoolClass.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudStack>

            @if (_classId is null)
            {
                <MudText Class="mud-text-secondary">@L["fees.pickClass"]</MudText>
            }
            else
            {
                @foreach (var (row, index) in _rows.Select((r, i) => (r, i)))
                {
                    @* @key keeps pickers glued to their row when a middle row is deleted. *@
                    <MudStack @key="row" Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mb-2" Wrap="Wrap.Wrap">
                        <MudSelect T="Guid?" @bind-Value="row.FeeHeadId" Label="@L["fees.head"]" Dense="true"
                                   Style="min-width: 160px;">
                            @foreach (var head in _heads)
                            {
                                <MudSelectItem T="Guid?" Value="@head.Id">@head.Name</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="row.Label" Label="@L["fees.installmentLabel"]"
                                      Style="width: 160px;" />
                        <MudNumericField T="decimal" @bind-Value="row.Amount" Label="@L["fees.amount"]" Min="1"
                                         Style="width: 140px;" HideSpinButtons="true" />
                        <MudDatePicker @bind-Date="row.DueDate" Label="@L["common.dueDate"]" Editable="true"
                                       Style="width: 150px;" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                       Size="Size.Small" OnClick="@(() => _rows.RemoveAt(index))" />
                    </MudStack>
                }

                <MudDivider Class="my-3" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@L["fees.splitHelp"]</MudText>
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
                    <MudSelect T="Guid?" @bind-Value="_splitHeadId" Label="@L["fees.head"]" Dense="true"
                               Style="min-width: 150px;">
                        @foreach (var head in _heads)
                        {
                            <MudSelectItem T="Guid?" Value="@head.Id">@head.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudNumericField T="decimal" @bind-Value="_splitTotal" Label="@L["fees.splitTotal"]" Min="1"
                                     Style="width: 130px;" HideSpinButtons="true" />
                    <MudNumericField T="int" @bind-Value="_splitCount" Label="@L["fees.installments"]" Min="2" Max="12"
                                     Style="width: 120px;" />
                    <MudDatePicker @bind-Date="_splitFirstDue" Label="@L["fees.firstDue"]" Editable="true"
                                   Style="width: 150px;" />
                    <MudNumericField T="int" @bind-Value="_splitMonthsApart" Label="@L["fees.monthsApart"]" Min="1" Max="6"
                                     Style="width: 120px;" />
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CallSplit"
                               OnClick="SplitIntoInstallments">@L["fees.split"]</MudButton>
                </MudStack>

                <MudStack Row="true" Spacing="2" Class="mt-4">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => _rows.Add(new PlanRow()))">
                        @L["fees.addInstallment"]
                    </MudButton>
                    <MudSpacer />
                    <MudText Typo="Typo.subtitle1" Class="align-self-center mr-4">
                        @L.Format("fees.totalLabel", _rows.Sum(r => r.Amount).ToString("N0"))
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_busy"
                               OnClick="SavePlanAsync">@L["fees.savePlan"]</MudButton>
                </MudStack>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private sealed class PlanRow
    {
        public Guid? FeeHeadId { get; set; }
        public string? Label { get; set; }
        public decimal Amount { get; set; } = 1000;
        public DateTime? DueDate { get; set; } = DateTime.Today.AddMonths(1);
    }

    private Guid? _splitHeadId;
    private decimal _splitTotal = 30000;
    private int _splitCount = 3;
    private DateTime? _splitFirstDue = DateTime.Today.AddMonths(1);
    private int _splitMonthsApart = 3;

    /// <summary>Equal split; the rupee remainder lands on the first term.</summary>
    private void SplitIntoInstallments()
    {
        if (_splitHeadId is null || _splitFirstDue is null || _splitCount < 2 || _splitTotal <= 0)
        {
            Snackbar.Add(L["fees.needSplitFields"], Severity.Warning);
            return;
        }

        var per = Math.Floor(_splitTotal / _splitCount);
        var remainder = _splitTotal - per * _splitCount;
        for (var i = 0; i < _splitCount; i++)
        {
            _rows.Add(new PlanRow
            {
                FeeHeadId = _splitHeadId,
                Label = L.Format("fees.termLabel", i + 1),
                Amount = per + (i == 0 ? remainder : 0),
                DueDate = _splitFirstDue.Value.AddMonths(i * _splitMonthsApart),
            });
        }
    }

    private List<FeeHeadDto> _heads = [];
    private List<SchoolClassDto> _classes = [];
    private Guid? _currentYearId;
    private Guid? _classId;
    private List<PlanRow> _rows = [];
    private string _newHeadName = string.Empty;
    private LateFineType _newHeadFineType = LateFineType.None;
    private decimal _newHeadFineValue;
    private bool _busy;

    private void OnLanguageChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => L.Changed -= OnLanguageChanged;

    protected override async Task OnInitializedAsync()
    {
        L.Changed += OnLanguageChanged;
        await Institution.EnsureLoadedAsync();
        try
        {
            var years = await AcademicsApi.GetYearsAsync();
            _currentYearId = years.FirstOrDefault(y => y.IsCurrent)?.Id ?? years.FirstOrDefault()?.Id;
            _heads = await Client.GetHeadsAsync();
            _classes = await AcademicsApi.GetClassesAsync();
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(L["common.cannotReach"], Severity.Error);
        }
    }

    private async Task CreateHeadAsync()
    {
        if (string.IsNullOrWhiteSpace(_newHeadName))
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateHeadAsync(
                _newHeadName.Trim(), _newHeadFineType, _newHeadFineValue);
            if (error is null)
            {
                _newHeadName = string.Empty;
                _newHeadFineType = LateFineType.None;
                _newHeadFineValue = 0;
                _heads = await Client.GetHeadsAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadPlanAsync()
    {
        if (_currentYearId is null || _classId is null)
        {
            return;
        }

        var items = await Client.GetStructureAsync(_currentYearId.Value, _classId.Value);
        _rows = items
                .Select(i => new PlanRow
                {
                    FeeHeadId = i.FeeHeadId,
                    Label = i.Label,
            Amount = i.Amount,
            DueDate = i.DueDate.ToDateTime(TimeOnly.MinValue),
        }).ToList();
        if (_rows.Count == 0)
        {
            _rows.Add(new PlanRow());
        }
    }

    private async Task SavePlanAsync()
    {
        if (_currentYearId is null || _classId is null)
        {
            return;
        }

        if (_rows.Any(r => r.FeeHeadId is null || r.DueDate is null || r.Amount <= 0))
        {
            Snackbar.Add(L["fees.needLineFields"], Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.DefineStructureAsync(new DefineFeeStructureRequest(
                _currentYearId.Value, _classId.Value,
                _rows.Select(r => new FeeStructureItemInput(
                    r.FeeHeadId!.Value, r.Amount, DateOnly.FromDateTime(r.DueDate!.Value),
                    string.IsNullOrWhiteSpace(r.Label) ? null : r.Label.Trim())).ToList()));
            if (error is null)
            {
                Snackbar.Add(L["fees.planSaved"], Severity.Success);
                await LoadPlanAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
