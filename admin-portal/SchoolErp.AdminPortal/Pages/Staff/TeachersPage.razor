@page "/teachers"
@attribute [Authorize]
@inject StaffClient Client
@inject TimetableClient TimetableApi
@inject ISnackbar Snackbar

<PageTitle>Teachers — SchoolErp</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Teachers</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_search" Label="Search name / code / phone" Clearable="true"
                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search"
                  OnAdornmentClick="LoadAsync" Immediate="false"
                  OnKeyUp="@(e => e.Key == "Enter" ? LoadAsync() : Task.CompletedTask)"
                  Style="min-width: 260px;" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd"
               OnClick="@(() => OpenEditor(null))">
        Add teacher
    </MudButton>
</MudStack>

<MudPaper Elevation="2" Class="pa-4 mb-4">
    <MudTable Items="_teachers" Dense="true" Hover="true" Loading="_loading">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="@(new Func<TeacherDto, object>(t => t.EmployeeCode))">Code</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<TeacherDto, object>(t => t.FullName))">Name</MudTableSortLabel></MudTh>
            <MudTh>Phone</MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<TeacherDto, object>(t => t.Specialization ?? ""))">Specialization</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<TeacherDto, object>(t => t.Qualification ?? ""))">Qualification</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="@(new Func<TeacherDto, object>(t => t.IsActive))">Status</MudTableSortLabel></MudTh>
            <MudTh />
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.EmployeeCode</MudTd>
            <MudTd>@context.FullName</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>@(context.Specialization ?? "—")</MudTd>
            <MudTd>@(context.Qualification ?? "—")</MudTd>
            <MudTd>
                <MudChip Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Active" : "Inactive")
                </MudChip>
                @if (context.HasLogin)
                {
                    <MudChip Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        Has login
                    </MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => OpenEditor(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.CalendarViewWeek" Size="Size.Small"
                               Color="@(_scheduleTeacher?.Id == context.Id ? Color.Primary : Color.Default)"
                               OnClick="@(() => ShowScheduleAsync(context))" />
                @if (!context.HasLogin)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small"
                                   title="Create login"
                                   OnClick="@(() => OpenLoginForm(context))" />
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary pa-4">No teachers yet — add the first one.</MudText>
        </NoRecordsContent>
    <PagerContent>
        <MudTablePager PageSizeOptions="new[] { 10, 25, 50 }" />
    </PagerContent>
    </MudTable>
</MudPaper>

@if (_editorOpen)
{
    <MudPaper Elevation="2" Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">
            @(_editing is null ? "Add teacher" : $"Edit {_editing.FullName}")
        </MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_form.EmployeeCode" Label="Employee code" Required="true"
                          Disabled="@(_editing is not null)" Style="width: 150px;" />
            <MudTextField @bind-Value="_form.FullName" Label="Full name" Required="true"
                          Style="min-width: 220px;" />
            <MudTextField @bind-Value="_form.Phone" Label="Phone (+91…)" Required="true"
                          Style="width: 170px;" />
            <MudTextField @bind-Value="_form.Email" Label="Email" Style="min-width: 220px;" />
            <MudTextField @bind-Value="_form.Qualification" Label="Qualification"
                          Style="min-width: 180px;" />
            <MudTextField @bind-Value="_form.Specialization" Label="Specialization (subjects)"
                          Style="min-width: 180px;" />
            <MudDatePicker @bind-Date="_form.JoinedOn" Label="Joined on" Style="width: 170px;" />
            @if (_editing is not null)
            {
                <MudSwitch @bind-Value="_form.IsActive" Color="Color.Success" Label="Active" />
            }
        </MudStack>
        <MudStack Row="true" Class="mt-4">
            <MudSpacer />
            <MudButton OnClick="@(() => _editorOpen = false)">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">
                @(_editing is null ? "Add teacher" : "Save changes")
            </MudButton>
        </MudStack>
    </MudPaper>
}

@if (_loginTeacher is { } loginTeacher)
{
    <MudPaper Elevation="2" Class="pa-6 mb-4">
        <MudText Typo="Typo.h6" Class="mb-1">Create login — @loginTeacher.FullName</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            Creates a staff account with the "Teacher" role (attendance, marks entry,
            homework, timetable). They sign in with
            @(loginTeacher.Email ?? loginTeacher.Phone) and this temporary password —
            or with a phone OTP.
        </MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudTextField @bind-Value="_loginPassword" Label="Temporary password"
                          HelperText="Min 8 chars, upper + lower + digit"
                          Style="min-width: 240px;" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy"
                       OnClick="CreateLoginAsync">
                Create login
            </MudButton>
            <MudButton OnClick="@(() => _loginTeacher = null)">Cancel</MudButton>
        </MudStack>
    </MudPaper>
}

<MudPaper Elevation="2" Class="pa-6 mb-4">
    <MudText Typo="Typo.h6" Class="mb-1">Substitutions</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Teacher absent for a day? Load their slots, pick free teachers, publish
        the cover plan. Suggestions exclude anyone already teaching or covering
        at the same time.
    </MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
        <MudSelect T="Guid?" @bind-Value="_subAbsentTeacherId" Label="Absent teacher"
                   Dense="true" Style="min-width: 190px;"
                   ToStringFunc="@(id => _teachers.FirstOrDefault(t => t.Id == id)?.FullName ?? "")">
            @foreach (var teacher in _teachers.Where(t => t.IsActive))
            {
                <MudSelectItem T="Guid?" Value="@teacher.Id">@teacher.FullName</MudSelectItem>
            }
        </MudSelect>
        <MudDatePicker @bind-Date="_subDate" Label="Date" Editable="true" Style="width: 160px;" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                   Disabled="@(_busy || _subAbsentTeacherId is null || _subDate is null)"
                   OnClick="LoadSubstitutionPlanAsync">
            Load slots
        </MudButton>
    </MudStack>

    @if (_subPlan is { } plan)
    {
        @if (plan.Count == 0)
        {
            <MudText Class="mud-text-secondary mt-3">
                No published slots for that teacher on that day.
            </MudText>
        }
        else
        {
            @foreach (var slot in plan)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center"
                          Wrap="Wrap.Wrap" Class="mt-3">
                    <MudChip Size="Size.Small" Variant="Variant.Outlined">
                        P@(slot.Period) · @slot.StartTime.ToString("HH\\:mm")
                    </MudChip>
                    <MudText Typo="Typo.body2">
                        @slot.SubjectName — @slot.ClassName @slot.SectionName
                    </MudText>
                    @if (slot.FreeTeachers.Count == 0)
                    {
                        <MudChip Size="Size.Small" Color="Color.Warning">No one free</MudChip>
                    }
                    else
                    {
                        <MudSelect T="Guid?" Label="Cover by" Dense="true"
                                   Style="min-width: 180px;"
                                   Value="@GetPick(slot.TimetableEntryId)"
                                   ValueChanged="@(v => SetPick(slot.TimetableEntryId, v))"
                                   ToStringFunc="@(id => slot.FreeTeachers.FirstOrDefault(t => t.TeacherId == id)?.FullName ?? "")">
                            @foreach (var candidate in slot.FreeTeachers)
                            {
                                <MudSelectItem T="Guid?" Value="@candidate.TeacherId">
                                    @candidate.FullName
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                    @if (slot.AlreadySubstitutedBy is not null)
                    {
                        <MudChip Size="Size.Small" Color="Color.Info">Already covered</MudChip>
                    }
                </MudStack>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                       Disabled="@(_busy || _subPicks.Count == 0)"
                       OnClick="PublishSubstitutionsAsync">
                Publish @_subPicks.Count substitution(s)
            </MudButton>
        }
    }

    @if (_subToday.Count > 0)
    {
        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">
            Covers on @(_subDate?.ToString("dd MMM yyyy"))
        </MudText>
        @foreach (var cover in _subToday)
        {
            <MudText Typo="Typo.body2" Class="mb-1">
                P@(cover.Period) @cover.SubjectName (@cover.ClassName):
                @cover.AbsentTeacherName → <b>@cover.SubstituteTeacherName</b>
            </MudText>
        }
    }
</MudPaper>

@if (_scheduleTeacher is not null)
{
    <MudPaper Elevation="2" Class="pa-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">@_scheduleTeacher.FullName — weekly schedule</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           OnClick="@(() => _scheduleTeacher = null)" />
        </MudStack>
        @if (_schedule.Count == 0)
        {
            <MudText Class="mud-text-secondary">No periods assigned yet.</MudText>
        }
        else
        {
            <div style="overflow-x: auto;">
                <MudSimpleTable Dense="true" Bordered="true" Style="min-width: 700px;">
                    <thead>
                        <tr>
                            <th>Day</th>
                            <th>Time</th>
                            <th>Period</th>
                            <th>Subject</th>
                            <th>Class</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in _schedule)
                        {
                            <tr>
                                <td>@DayNames[slot.DayOfWeek]</td>
                                <td>@slot.StartTime.ToString("HH\\:mm")–@slot.EndTime.ToString("HH\\:mm")</td>
                                <td>@slot.Period</td>
                                <td>@slot.SubjectName</td>
                                <td>@slot.ClassName@(slot.SectionName is null ? "" : $" {slot.SectionName}")</td>
                                <td>
                                    <MudChip Size="Size.Small"
                                             Color="@(slot.IsPublished ? Color.Success : Color.Warning)">
                                        @(slot.IsPublished ? "Published" : "Draft")
                                    </MudChip>
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>
}

@code {
    private static readonly string[] DayNames =
        ["", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"];

    private sealed class TeacherForm
    {
        public string EmployeeCode { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Phone { get; set; } = "";
        public string? Email { get; set; }
        public string? Qualification { get; set; }
        public string? Specialization { get; set; }
        public DateTime? JoinedOn { get; set; }
        public bool IsActive { get; set; } = true;
    }

    private List<TeacherDto> _teachers = [];
    private List<TeacherScheduleItemDto> _schedule = [];
    private TeacherDto? _editing;
    private TeacherDto? _scheduleTeacher;
    private TeacherDto? _loginTeacher;
    private string _loginPassword = string.Empty;
    private TeacherForm _form = new();
    private string? _search;
    private bool _editorOpen;
    private bool _loading = true;
    private bool _busy;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _teachers = await Client.GetTeachersAsync(_search);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenEditor(TeacherDto? teacher)
    {
        _editing = teacher;
        _form = teacher is null
            ? new TeacherForm()
            : new TeacherForm
            {
                EmployeeCode = teacher.EmployeeCode,
                FullName = teacher.FullName,
                Phone = teacher.Phone,
                Email = teacher.Email,
                Qualification = teacher.Qualification,
                Specialization = teacher.Specialization,
                JoinedOn = teacher.JoinedOn?.ToDateTime(TimeOnly.MinValue),
                IsActive = teacher.IsActive,
            };
        _editorOpen = true;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.FullName) || string.IsNullOrWhiteSpace(_form.Phone) ||
            (_editing is null && string.IsNullOrWhiteSpace(_form.EmployeeCode)))
        {
            Snackbar.Add("Employee code, name and phone are required.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var joined = _form.JoinedOn is { } j ? DateOnly.FromDateTime(j) : (DateOnly?)null;
            var error = _editing is null
                ? await Client.CreateAsync(new CreateTeacherRequest(
                    _form.EmployeeCode.Trim(), _form.FullName.Trim(), _form.Phone.Trim(),
                    NullIfBlank(_form.Email), NullIfBlank(_form.Qualification),
                    NullIfBlank(_form.Specialization), joined))
                : await Client.UpdateAsync(new UpdateTeacherRequest(
                    _editing.Id, _form.FullName.Trim(), _form.Phone.Trim(),
                    NullIfBlank(_form.Email), NullIfBlank(_form.Qualification),
                    NullIfBlank(_form.Specialization), joined, _form.IsActive));
            if (error is null)
            {
                Snackbar.Add(_editing is null ? "Teacher added." : "Teacher updated.", Severity.Success);
                _editorOpen = false;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private Guid? _subAbsentTeacherId;
    private DateTime? _subDate = DateTime.Today;
    private List<SubstitutionSlotDto>? _subPlan;
    private List<SubstitutionDto> _subToday = [];
    private readonly Dictionary<Guid, Guid> _subPicks = [];

    private Guid? GetPick(Guid entryId) =>
        _subPicks.TryGetValue(entryId, out var teacherId) ? teacherId : null;

    private void SetPick(Guid entryId, Guid? teacherId)
    {
        if (teacherId is { } picked)
        {
            _subPicks[entryId] = picked;
        }
        else
        {
            _subPicks.Remove(entryId);
        }
    }

    private async Task LoadSubstitutionPlanAsync()
    {
        if (_subAbsentTeacherId is null || _subDate is null)
        {
            return;
        }

        _busy = true;
        try
        {
            var date = DateOnly.FromDateTime(_subDate.Value);
            _subPicks.Clear();
            _subPlan = await TimetableApi.GetSubstitutionPlanAsync(
                _subAbsentTeacherId.Value, date);
            _subToday = await TimetableApi.GetSubstitutionsAsync(date);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PublishSubstitutionsAsync()
    {
        if (_subAbsentTeacherId is null || _subDate is null || _subPicks.Count == 0)
        {
            return;
        }

        _busy = true;
        try
        {
            var error = await TimetableApi.ApplySubstitutionsAsync(
                _subAbsentTeacherId.Value,
                DateOnly.FromDateTime(_subDate.Value),
                _subPicks.Select(p => new SubstitutionInput(p.Key, p.Value)).ToList());
            if (error is null)
            {
                Snackbar.Add("Substitutions published.", Severity.Success);
                await LoadSubstitutionPlanAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void OpenLoginForm(TeacherDto teacher)
    {
        _loginTeacher = teacher;
        _loginPassword = string.Empty;
    }

    private async Task CreateLoginAsync()
    {
        if (_loginTeacher is null || string.IsNullOrWhiteSpace(_loginPassword))
        {
            Snackbar.Add("Enter a temporary password.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var error = await Client.CreateLoginAsync(_loginTeacher.Id, _loginPassword);
            if (error is null)
            {
                Snackbar.Add(
                    $"Login created. {_loginTeacher.FullName} signs in with " +
                    $"{_loginTeacher.Email ?? _loginTeacher.Phone} and the temporary password.",
                    Severity.Success);
                _loginTeacher = null;
                await LoadAsync();
            }
            else
            {
                Snackbar.Add(error, Severity.Error);
            }
        }
        catch (HttpRequestException)
        {
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ShowScheduleAsync(TeacherDto teacher)
    {
        _scheduleTeacher = teacher;
        try
        {
            _schedule = await Client.GetScheduleAsync(teacher.Id);
        }
        catch (HttpRequestException)
        {
            _schedule = [];
            Snackbar.Add("Cannot reach the server.", Severity.Error);
        }
    }

    private static string? NullIfBlank(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}
